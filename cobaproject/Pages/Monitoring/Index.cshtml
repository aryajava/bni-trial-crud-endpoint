@page
@model cobaproject.Pages.Monitoring.IndexModel
@{
    ViewData["Title"] = Model.CanDecide ? "Persetujuan Diskon" : "Permintaan Diskon Saya";
}

<div class="page-header">
    <h1><span class="material-icons">@(Model.CanDecide ? "fact_check" : "receipt_long")</span> @ViewData["Title"]</h1>
</div>

<div class="d-flex flex-wrap gap-2 mb-3 align-items-end">
    <div class="d-flex flex-column gap-1">
        <label class="cluster-label text-secondary fw-semibold mb-0" for="statusSelect">Status</label>
        <select id="statusSelect" class="form-select form-select-sm" style="width: 160px;">
            <option value="">Semua Status</option>
            <option value="MENUNGGU">Menunggu</option>
            <option value="DISETUJUI">Disetujui</option>
            <option value="DITOLAK">Ditolak</option>
        </select>
    </div>
    <div class="d-flex flex-column gap-1 flex-grow-1" style="max-width: 320px;">
        <label class="cluster-label text-secondary fw-semibold mb-0" for="searchInput">Cari</label>
        <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Judul produk atau pengaju..." autocomplete="off" />
    </div>
</div>

<div class="card card-soft">
    <div class="card-body p-3">
        <div class="table-wrap">
            <table class="table table-data align-middle mb-0">
                <thead>
                    <tr>
                        <th class="col-no text-center">No</th>
                        @if (Model.CanDecide)
                        {
                            <th class="col-aksi">Keputusan</th>
                        }
                        <th><button type="button" class="th-sort" data-sort="id">ID <span class="material-icons sort-ic">swap_vert</span></button></th>
                        <th><button type="button" class="th-sort" data-sort="title">Produk <span class="material-icons sort-ic">swap_vert</span></button></th>
                        <th><button type="button" class="th-sort" data-sort="newValue">Permintaan Diskon <span class="material-icons sort-ic">swap_vert</span></button></th>
                        <th><button type="button" class="th-sort" data-sort="status">Status <span class="material-icons sort-ic">swap_vert</span></button></th>
                        <th><button type="button" class="th-sort" data-sort="createdAt">Diajukan <span class="material-icons sort-ic">swap_vert</span></button></th>
                        <th><button type="button" class="th-sort" data-sort="requestedBy">Pengaju <span class="material-icons sort-ic">swap_vert</span></button></th>
                        <th><button type="button" class="th-sort" data-sort="reason">Catatan <span class="material-icons sort-ic">swap_vert</span></button></th>
                    </tr>
                </thead>
                <tbody id="approvalRows"></tbody>
            </table>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
            <div id="pageInfo" class="text-muted small"></div>
            <ul id="pagination" class="pagination pagination-sm mb-0"></ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_KEY_HEADER = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApiKeyHeader));
        const API_KEY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApiKey));
        const CAN_DECIDE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CanDecide));
        const URL_APPROVE = '@Url.Page("Index", "Approve")';
        const URL_REJECT = '@Url.Page("Index", "Reject")';

        const state = {
            page: 1,
            pageSize: 10,
            sortBy: '',
            sortOrder: 'desc',
            status: '',
            search: '',
            totalPages: 0
        };

        const $ = (id) => document.getElementById(id);

        function esc(s) {
            return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function restoreFromUrl() {
            const q = new URLSearchParams(location.search);
            const page = Number(q.get('page'));
            if (page >= 1) state.page = page;
            if (q.get('sortBy')) state.sortBy = q.get('sortBy');
            if (q.get('sortOrder') === 'asc' || q.get('sortOrder') === 'desc') state.sortOrder = q.get('sortOrder');
            if (q.get('status')) { state.status = q.get('status'); $('statusSelect').value = state.status; }
            if (q.get('search')) { state.search = q.get('search'); $('searchInput').value = state.search; }
        }

        function pushUrl() {
            const q = new URLSearchParams();
            if (state.page > 1) q.set('page', state.page);
            if (state.sortBy && (state.sortBy !== 'createdAt' || state.sortOrder !== 'desc')) {
                q.set('sortBy', state.sortBy);
                q.set('sortOrder', state.sortOrder);
            }
            if (state.status) q.set('status', state.status);
            if (state.search) q.set('search', state.search);
            const us = q.toString();
            history.replaceState(null, '', us ? '?' + us : location.pathname);
        }

        function buildQuery() {
            const q = new URLSearchParams();
            q.set('page', state.page);
            q.set('pageSize', state.pageSize);
            q.set('sortBy', state.sortBy);
            q.set('sortOrder', state.sortOrder);
            if (state.status) q.set('status', state.status);
            if (state.search.trim()) q.set('search', state.search.trim());
            return q.toString();
        }

        function badgeStatus(status) {
            if (status === 'MENUNGGU') return '<span class="badge bg-warning-subtle text-warning-emphasis">Menunggu</span>';
            if (status === 'DISETUJUI') return '<span class="badge bg-success-subtle text-success-emphasis">Disetujui</span>';
            return '<span class="badge bg-danger-subtle text-danger-emphasis">Ditolak</span>';
        }

        function formatDateTime(iso) {
            if (!iso) return '-';
            const d = new Date(iso);
            if (isNaN(d)) return '-';
            return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) +
                ', ' + d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
        }

        function renderRows(items) {
            const tbody = $('approvalRows');
            if (!items || items.length === 0) {
                tbody.innerHTML = '<tr class="row-empty"><td colspan="' + (CAN_DECIDE ? 9 : 8) + '"><span class="material-icons">inbox</span> Tidak ada data yang cocok dengan kriteria.</td></tr>';
                return;
            }
            tbody.innerHTML = items.map((item, idx) => {
                const nomor = ((state.page - 1) * state.pageSize) + idx + 1;
                const menunggu = item.status === 'MENUNGGU';
                const diskon = '<span class="text-muted text-decoration-line-through">' + (item.oldValue != null ? item.oldValue + '%' : '-') + '</span>' +
                    '<span class="material-icons arrow-next" style="vertical-align: middle; font-size: 16px;">arrow_forward</span>' +
                    '<span class="fw-semibold text-primary">' + (item.newValue != null ? item.newValue + '%' : '-') + '</span>';
                const catatan = item.reason
                    ? esc(item.reason) + (!CAN_DECIDE && item.decidedAt
                        ? '<small class="text-muted d-block">(oleh ' + (item.decidedBy === 'SISTEM' ? 'otomatis' : esc(item.decidedBy)) + ', ' + formatDateTime(item.decidedAt) + ')</small>'
                        : '')
                    : '<span class="text-muted">—</span>';
                let keputusan = '<span class="text-muted">—</span>';
                if (CAN_DECIDE && menunggu) {
                    keputusan = '<div class="field-actions">' +
                        '<form method="post" action="' + URL_APPROVE + '" class="m-0 form-approve">' +
                        '<input type="hidden" name="id" value="' + item.id + '" />' +
                        '<input type="hidden" name="version" value="' + item.version + '" />' +
                        '<input type="hidden" name="reason" class="reason-input" />' +
                        '<button type="submit" class="btn btn-success btn-sm btn-approve" title="Setujui diskon"><span class="material-icons">check</span></button>' +
                        '</form>' +
                        '<form method="post" action="' + URL_REJECT + '" class="m-0 form-reject">' +
                        '<input type="hidden" name="id" value="' + item.id + '" />' +
                        '<input type="hidden" name="version" value="' + item.version + '" />' +
                        '<input type="hidden" name="reason" class="reason-input" />' +
                        '<button type="submit" class="btn btn-outline-danger btn-sm btn-reject" title="Tolak diskon"><span class="material-icons">close</span></button>' +
                        '</form>' +
                        '</div>';
                }
                return '<tr>' +
                    '<td class="td-nomor text-center">' + nomor + '</td>' +
                    (CAN_DECIDE ? '<td>' + keputusan + '</td>' : '') +
                    '<td class="td-id">' + item.productId + '</td>' +
                    '<td class="fw-semibold">' + esc(item.title) + '</td>' +
                    '<td>' + diskon + '</td>' +
                    '<td>' + badgeStatus(item.status) + '</td>' +
                    '<td class="td-nomor">' + formatDateTime(item.requestedAt) + '</td>' +
                    '<td>' + esc(item.requestedBy) + '</td>' +
                    '<td>' + catatan + '</td>' +
                    '</tr>';
            }).join('');
        }

        function buildPages(current, total) {
            if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
            const candidates = [1, total];
            for (let i = current - 2; i <= current + 2; i++) if (i >= 1 && i <= total) candidates.push(i);
            return [...new Set(candidates)].sort((a, b) => a - b);
        }

        function renderPagination() {
            const el = $('pagination');
            const total = Math.max(1, state.totalPages);
            const parts = [];
            const item = (icon, page, disabled, label) =>
                '<li class="page-item ' + (disabled ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="' + page + '" title="' + label + '"><span class="material-icons">' + icon + '</span></a></li>';
            parts.push(item('chevron_left', state.page - 1, state.page <= 1, 'Halaman sebelumnya'));
            for (const p of buildPages(state.page, state.totalPages)) {
                if (p === '...') parts.push('<li class="page-item disabled"><span class="page-link pg-ellipsis">. . .</span></li>');
                else parts.push('<li class="page-item ' + (p === state.page ? 'active' : '') + '"><a class="page-link" href="#" data-page="' + p + '">' + p + '</a></li>');
            }
            parts.push(item('chevron_right', state.page + 1, state.page >= total, 'Halaman berikutnya'));
            el.innerHTML = parts.join('');
        }

        function setPageMeta(page, total, totalPages) {
            state.page = page;
            state.totalPages = totalPages;
            $('pageInfo').textContent = total === 0
                ? 'Hal 0 dari 0 (0 data)'
                : 'Hal ' + page + ' dari ' + totalPages + ' (' + total + ' data)';
            renderPagination();
        }

        function updateSortIndicators() {
            document.querySelectorAll('.th-sort').forEach((btn) => {
                const active = btn.dataset.sort === state.sortBy;
                btn.classList.toggle('active', active);
                const ic = btn.querySelector('.sort-ic');
                if (!ic) return;
                if (active) ic.textContent = state.sortOrder === 'asc' ? 'arrow_upward' : 'arrow_downward';
                else ic.textContent = 'swap_vert';
            });
        }

        async function loadData() {
            const tbody = $('approvalRows');
            tbody.innerHTML = '<tr class="row-loading"><td colspan="' + (CAN_DECIDE ? 9 : 8) + '"><span class="material-icons spinner-icon">autorenew</span> Memuat data...</td></tr>';
            try {
                const res = await fetch('/api/discount-approvals?' + buildQuery(), { headers: { [API_KEY_HEADER]: API_KEY } });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const json = await res.json();
                if (!json.isSuccess) throw new Error(json.message || 'Gagal memuat data.');
                renderRows(json.data.items);
                setPageMeta(json.data.page, json.data.total, json.data.totalPages);
            } catch (err) {
                tbody.innerHTML = '<tr class="row-empty"><td colspan="' + (CAN_DECIDE ? 9 : 8) + '">Gagal memuat data: ' + esc(err.message) + '</td></tr>';
                setPageMeta(1, 0, 0);
            } finally {
                updateSortIndicators();
                pushUrl();
            }
        }

        function onApproveClick(btn) {
            const form = btn.closest('.form-approve');
            Swal.fire({
                title: 'Setujui Permintaan Diskon',
                input: 'text',
                inputLabel: 'Catatan (opsional)',
                inputValue: 'Disetujui',
                showCancelButton: true,
                confirmButtonText: 'Setujui',
                cancelButtonText: 'Batal',
                icon: 'success'
            }).then(function (result) {
                if (result.isConfirmed) {
                    form.querySelector('.reason-input').value = (result.value || '').trim();
                    form.submit();
                }
            });
        }

        function onRejectClick(btn) {
            const form = btn.closest('.form-reject');
            Swal.fire({
                title: 'Tolak Permintaan Diskon',
                input: 'text',
                inputLabel: 'Alasan (wajib diisi)',
                inputPlaceholder: 'Contoh: diskon terlalu besar',
                inputValidator: function (value) {
                    if (!value || !value.trim()) {
                        return 'Alasan penolakan wajib diisi.';
                    }
                },
                showCancelButton: true,
                confirmButtonText: 'Tolak',
                cancelButtonText: 'Batal',
                icon: 'warning'
            }).then(function (result) {
                if (result.isConfirmed) {
                    form.querySelector('.reason-input').value = (result.value || '').trim();
                    form.submit();
                }
            });
        }

        let searchTimer = null;
        document.addEventListener('DOMContentLoaded', () => {
            restoreFromUrl();

            $('searchInput').addEventListener('input', () => {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(() => {
                    state.search = $('searchInput').value;
                    state.page = 1;
                    loadData();
                }, 350);
            });
            $('statusSelect').addEventListener('change', (e) => {
                state.status = e.target.value;
                state.page = 1;
                loadData();
            });
            document.querySelectorAll('.th-sort').forEach((btn) => btn.addEventListener('click', () => {
                const col = btn.dataset.sort;
                if (state.sortBy === col) {
                    if (state.sortOrder === 'asc') state.sortOrder = 'desc';
                    else { state.sortBy = ''; state.sortOrder = 'desc'; }
                } else {
                    state.sortBy = col;
                    state.sortOrder = 'asc';
                }
                state.page = 1;
                loadData();
            }));
            $('pagination').addEventListener('click', (e) => {
                const link = e.target.closest('.page-link');
                if (!link || link.closest('.disabled')) return;
                e.preventDefault();
                const page = Number(link.dataset.page);
                if (page >= 1 && page <= state.totalPages && page !== state.page) {
                    state.page = page;
                    loadData();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
            $('approvalRows').addEventListener('click', (e) => {
                const approve = e.target.closest('.btn-approve');
                if (approve) { e.preventDefault(); onApproveClick(approve); return; }
                const reject = e.target.closest('.btn-reject');
                if (reject) { e.preventDefault(); onRejectClick(reject); }
            });

            loadData();
        });
    </script>
}