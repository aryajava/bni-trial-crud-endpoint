@page
@model cobaproject.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}
<div class="page-header">
    <h1>Login</h1>
</div>

<div class="card card-soft" style="max-width: 420px;">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="Username">Username</label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Password">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <input type="hidden" name="returnUrl" value="@Request.Query["ReturnUrl"]" />

            <button class="btn btn-primary w-100" type="submit"><span class="material-icons">login</span> Masuk</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}