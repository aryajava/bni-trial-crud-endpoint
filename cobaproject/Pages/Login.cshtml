@page
@model cobaproject.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
}

<form method="post">
    <div class="mb-3">
        <label class="form-label" asp-for="Username">Username</label>
        <div class="input-group">
            <span class="input-group-text"><span class="material-icons">person</span></span>
            <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
        </div>
        <span asp-validation-for="Username" class="field-error"></span>
    </div>

    <div class="mb-4">
        <label class="form-label" asp-for="Password">Password</label>
        <div class="input-group">
            <span class="input-group-text"><span class="material-icons">lock</span></span>
            <input asp-for="Password" class="form-control" autocomplete="current-password" id="inputPassword" />
            <button class="btn btn-outline-secondary" type="button" id="togglePassword" tabindex="-1" title="Perlihatkan/sembunyikan password">
                <span class="material-icons" id="togglePasswordIcon">visibility</span>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <input type="hidden" name="returnUrl" value="@Request.Query["ReturnUrl"]" />

    <button class="btn btn-masuk w-100 text-white py-2" type="submit">
        <span class="material-icons">login</span> Masuk
    </button>
</form>

@section Scripts {
    <script>
        document.getElementById("togglePassword").addEventListener("click", function () {
            var input = document.getElementById("inputPassword");
            var icon = document.getElementById("togglePasswordIcon");
            var tersembunyi = input.type === "password";
            input.type = tersembunyi ? "text" : "password";
            icon.textContent = tersembunyi ? "visibility_off" : "visibility";
            input.focus();
        });
    </script>
}