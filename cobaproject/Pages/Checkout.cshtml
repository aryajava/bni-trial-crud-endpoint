@page
@model cobaproject.Pages.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
    Layout = "_TokoLayout";
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card card-toko">
            <div class="card-body">
                <h1 class="h4 mb-3"><span class="material-icons">local_shipping</span> Data Pengiriman</h1>

                @if (!string.IsNullOrWhiteSpace(Model.StoreError))
                {
                    <div class="alert alert-danger py-2 small">@Model.StoreError</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label" asp-for="Form.Name">Nama Penerima</label>
                        <input asp-for="Form.Name" class="form-control" autocomplete="name" />
                        @Html.ValidationMessageFor(m => m.Form.Name, null, new { @class = "field-error" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Form.Phone">No. HP</label>
                        <input asp-for="Form.Phone" class="form-control" autocomplete="tel" />
                        @Html.ValidationMessageFor(m => m.Form.Phone, null, new { @class = "field-error" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Form.Address">Alamat Pengiriman</label>
                        <textarea asp-for="Form.Address" class="form-control" rows="3" autocomplete="street-address"></textarea>
                        @Html.ValidationMessageFor(m => m.Form.Address, null, new { @class = "field-error" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Form.Note">Catatan (opsional)</label>
                        <input asp-for="Form.Note" class="form-control" placeholder="Contoh: hubungi sebelum kirim" />
                        @Html.ValidationMessageFor(m => m.Form.Note, null, new { @class = "field-error" })
                    </div>
                    <button class="btn btn-primary" type="button" id="btnBukaKonfirmasi" data-bs-toggle="modal" data-bs-target="#modalKonfirmasi" style="border-radius:10px;">
                        <span class="material-icons">check_circle</span> Buat Pesanan
                    </button>

                    <div class="modal fade" id="modalKonfirmasi" tabindex="-1" aria-labelledby="modalKonfirmasiJudul" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content" style="border-radius:14px;">
                                <div class="modal-header">
                                    <h2 class="modal-title h5 mb-0" id="modalKonfirmasiJudul">Konfirmasi Pesanan</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="text-muted small mb-3">Periksa kembali alamat pengiriman dan ringkasan pesanan sebelum mengonfirmasi.</p>
                                    <div class="mb-3">
                                        <label class="form-label" asp-for="Password">Konfirmasi Kata Sandi</label>
                                        <input asp-for="Password" type="password" class="form-control" style="border-radius:10px;" autocomplete="current-password" placeholder="Kata sandi akun Anda" />
                                        @Html.ValidationMessageFor(m => m.Password, null, new { @class = "field-error" })
                                    </div>
                                    @if (Model.AltchaAktif)
                                    {
                                        <div class="mb-3" id="altchaSlot">
                                            <div class="text-muted small mb-1">Verifikasi keamanan</div>
                                            <span class="field-error">@Html.ValidationMessage("AltchaPayload")</span>
                                        </div>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal" style="border-radius:10px;">Batal</button>
                                    <button type="submit" class="btn btn-primary btn-sm" id="btnKonfirmasiFinal" style="border-radius:10px;">
                                        <span class="material-icons">check_circle</span> Ya, Buat Pesanan
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card card-toko">
            <div class="card-body">
                <h2 class="h5 mb-3">Ringkasan Pesanan</h2>
                @if (Model.Items.Count == 0)
                {
                    <p class="text-muted small">Tidak ada item untuk dipesan. <a href="/Keranjang">Cek keranjang</a>.</p>
                }
                else
                {
                    <div id="notifRingkasan" class="alert alert-warning py-2 small mb-3 d-none"></div>
                    <div class="mb-3">
                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@item.Title
                                    <span class="text-muted d-block">
                                        @if (item.DiscountPercent is > 0)
                                        {
                                            <span class="text-decoration-line-through me-1">Rp @item.Price.ToString("N0")</span>
                                        }@item.EffectivePrice.ToString("N0") × @item.Quantity
                                    </span>
                                </span>
                                <span class="fw-semibold td-nomor">Rp @item.Subtotal.ToString("N0")</span>
                            </div>
                        }
                    </div>
                    @if (Model.Couriers.Count > 0)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1" for="courierSelect">Ekspedisi</label>
                            <select id="courierSelect" name="CourierId" class="form-select" style="border-radius:10px;" onchange="hitungRingkasan()">
                                @foreach (var c in Model.Couriers)
                                {
                                    <option value="@c.Id" selected="@(c.Id == Model.CourierId)" data-ongkir="@c.ShippingFee">@c.Name - Rp @c.ShippingFee.ToString("N0")</option>
                                }
                            </select>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between small"><span>Subtotal</span><span id="sumSubtotal">Rp @Model.Subtotal.ToString("N0")</span></div>
                    <div class="d-flex justify-content-between small"><span>Ongkir (@if (Model.Couriers.Count > 0) { <span id="sumCourier">@(Model.Couriers.FirstOrDefault(c => c.Id == Model.CourierId)?.Name)</span> } else { <text>default</text> })</span><span id="sumOngkir">Rp @Model.ShippingFee.ToString("N0")</span></div>
                    <div class="d-flex justify-content-between small"><span>Pajak</span><span id="sumPajak">Rp @Model.TaxAmount.ToString("N0")</span></div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold"><span>Total</span><span class="text-primary" id="sumTotal">Rp @Model.Total.ToString("N0")</span></div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var RINGKASAN_SUBTOTAL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Subtotal));
        var RINGKASAN_PAJAK = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TaxPercent));

        function formatRp(n) { return 'Rp ' + Math.round(n || 0).toLocaleString('id-ID'); }

        function hitungRingkasan() {
            var sel = document.getElementById('courierSelect');
            if (!sel) { return; }
            var opt = sel.options[sel.selectedIndex];
            var ongkir = Number(opt.dataset.ongkir || 0);
            var pajak = Math.round(RINGKASAN_SUBTOTAL * RINGKASAN_PAJAK / 100 * 100) / 100;
            document.getElementById('sumOngkir').textContent = formatRp(ongkir);
            document.getElementById('sumPajak').textContent = formatRp(pajak);
            document.getElementById('sumTotal').textContent = formatRp(RINGKASAN_SUBTOTAL + ongkir + pajak);
            document.getElementById('sumCourier').textContent = opt.text.split(' - ')[0];
        }

        var modalKonfirmasi = document.getElementById('modalKonfirmasi');
        var altchaSlot = document.getElementById('altchaSlot');
        var btnKonfirmasiFinal = document.getElementById('btnKonfirmasiFinal');

        var ALTCHA_AKTIF = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AltchaAktif));

        if (modalKonfirmasi) {
            if (ALTCHA_AKTIF && altchaSlot && btnKonfirmasiFinal) {
                btnKonfirmasiFinal.disabled = true;
                modalKonfirmasi.addEventListener('show.bs.modal', function () {
                    altchaSlot.innerHTML = '';
                    var w = document.createElement('altcha-widget');
                    w.setAttribute('challengeurl', '/Checkout?handler=Altcha');
                    w.setAttribute('type', 'checkbox');
                    w.setAttribute('hidelogo', 'true');
                    w.setAttribute('hidefooter', 'true');
                    w.addEventListener('statechange', function (ev) {
                        if (ev.detail && ev.detail.state === 'verified') {
                            btnKonfirmasiFinal.disabled = false;
                        }
                    });
                    altchaSlot.insertBefore(w, altchaSlot.firstChild);
                });
                modalKonfirmasi.addEventListener('hidden.bs.modal', function () {
                    altchaSlot.innerHTML = '';
                    btnKonfirmasiFinal.disabled = true;
                });
            }
        }
    </script>
    @if (Model.AltchaAktif)
    {
        <script src="/js/altcha.min.js" type="module"></script>
    }
}