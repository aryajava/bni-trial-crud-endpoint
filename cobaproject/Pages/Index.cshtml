@page
@model cobaproject.Pages.IndexModel
@using cobaproject.Helpers
@{
    ViewData["Title"] = "Belanja";
    Layout = "_TokoLayout";
    var total = Model.Products.Total;
    var dari = total == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var sampai = Math.Min(Model.Page * Model.PageSize, total);
    var qUrled = Uri.EscapeDataString(Model.Search ?? "");
    var katUrled = Uri.EscapeDataString(Model.Category ?? "");

}

<div class="mb-3">
    <h1 class="h3 fw-bold mb-1">Katalog Produk</h1>
    <p class="text-muted small mb-0">@total produk tersedia</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Category))
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        @if (!string.IsNullOrWhiteSpace(Model.Category))
        {
            <a class="chip-kategori aktif" href="/?q=@qUrled">@Model.Category <span class="material-icons" style="font-size:14px;">close</span></a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="chip-kategori aktif" href="/?kategori=@katUrled">"@Model.Search" <span class="material-icons" style="font-size:14px;">close</span></a>
        }
        <a class="chip-kategori" href="/">Hapus semua</a>
    </div>
}

<div class="d-lg-none mb-3">
    <div class="d-flex gap-2 overflow-auto pb-1" style="scrollbar-width:none;">
        <a class="chip-kategori @(string.IsNullOrEmpty(Model.Category) ? "aktif" : "")" href="/?q=@qUrled">Semua</a>
        @foreach (var c in Model.Categories)
        {
            <a class="chip-kategori @(Model.Category == c.Name ? "aktif" : "")"
               href="/?kategori=@Uri.EscapeDataString(c.Name)&q=@qUrled">@c.Name (@c.ProductCount)</a>
        }
    </div>
</div>

<div class="row g-4">
    <aside class="col-lg-3 d-none d-lg-block">
        <div class="card-toko p-2" style="position:sticky;top:76px;">
            <h2 class="fs-6 fw-semibold px-2 pt-2 pb-1 mb-1">Kategori</h2>
            <a class="fil-kategori @(string.IsNullOrEmpty(Model.Category) ? "aktif" : "")" href="/?q=@qUrled">
                <span>Semua</span><span class="jml">@Model.TotalAll</span>
            </a>
            @foreach (var c in Model.Categories)
            {
                <a class="fil-kategori @(Model.Category == c.Name ? "aktif" : "")"
                   href="/?kategori=@Uri.EscapeDataString(c.Name)&q=@qUrled">
                    <span>@c.Name</span><span class="jml">@c.ProductCount</span>
                </a>
            }
        </div>
    </aside>

    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="text-muted small">
                @if (total == 0)
                {
                    <span>Tidak ada produk</span>
                }
                else
                {
                    <span>Menampilkan @dari hingga @sampai dari @total produk</span>
                }
            </div>
        </div>

        @if (Model.Products.Items.Count == 0)
        {
            <div class="card-toko text-center text-muted py-5">
                <span class="material-icons" style="font-size:56px;color:#B7BEC7;">search_off</span>
                <p class="mt-3 mb-1 fw-semibold" style="color:#5B6470;">Tidak ada produk yang cocok</p>
                <p class="small mb-3">Coba kata kunci atau kategori lain.</p>
                <a class="btn btn-outline-secondary btn-sm" href="/" style="border-radius:10px;">Lihat Semua Produk</a>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-sm-3 row-cols-xl-4 g-3">
                @foreach (var p in Model.Products.Items)
                {
                    var habis = p.Stock <= 0;
                    var harga = Model.HargaEfektif(p);
                    <div class="col">
                        <div class="card card-produk">
                            <a href="/Produk/Detail/@p.Id" class="d-block text-decoration-none">
                                <div class="img-wrap position-relative">
                                    @if (p.DiscountPercent is > 0)
                                    {
                                        <span class="badge badge-diskon">-@p.DiscountPercent%</span>
                                    }
                                    @if (habis)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis badge-habis">Habis</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.Image))
                                    {
                                        <img src="@p.Image" alt="@p.Title" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="material-icons text-secondary" style="font-size:56px;">inventory_2</span>
                                    }
                                </div>
                            </a>
                            <div class="card-body d-flex flex-column gap-2" style="padding:12px 14px 14px;">
                                <a href="/Produk/Detail/@p.Id" class="text-decoration-none">
                                    <div class="judul-produk">@p.Title</div>
                                </a>
                                <div>
                                    @if (p.DiscountPercent is > 0)
                                    {
                                        <div class="harga-asli">Rp @p.Price.ToString("N0")</div>
                                    }
                                    <span class="harga-efektif">Rp @harga.ToString("N0")</span>
                                </div>
                                @if (habis)
                                {
                                    <button class="btn btn-outline-secondary btn-sm w-100" disabled style="border-radius:10px;">Stok Habis</button>
                                }
                                else if (Model.IsCustomer)
                                {
                                    <form method="post" action="/Keranjang?handler=Add" class="d-grid">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@p.Id" />
                                        <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.Path@ViewContext.HttpContext.Request.QueryString" />
                                        <button class="btn btn-primary btn-sm" type="submit" style="border-radius:10px;">
                                            <span class="material-icons">add_shopping_cart</span> Tambah
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm w-100 btn-tambah-tamu" data-product-id="@p.Id" type="button" style="border-radius:10px;">
                                        <span class="material-icons">add_shopping_cart</span> Tambah
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.Products.TotalPages > 1)
{
    var halamanItems = new List<object>();
    var pages = new SortedSet<int> { 1, Model.Products.TotalPages };
    for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
    {
        if (i >= 1 && i <= Model.Products.TotalPages) pages.Add(i);
    }
    var urut = pages.ToList();
    int? sebelumnya = null;
    foreach (var h in urut)
    {
        if (sebelumnya.HasValue && h - sebelumnya.Value > 1) halamanItems.Add("...");
        halamanItems.Add(h);
        sebelumnya = h;
    }
    <nav class="mt-4" aria-label="Navigasi halaman">
        <ul class="pagination pagination-toko justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Page("Index", new { page = Model.Page - 1, q = Model.Search, kategori = Model.Category })" aria-label="Halaman sebelumnya">
                    <span class="material-icons" style="font-size:18px;">chevron_left</span>
                </a>
            </li>
            @foreach (var item in halamanItems)
            {
                if (item is int halaman)
                {
                    <li class="page-item @(halaman == Model.Page ? "active" : "")">
                        <a class="page-link" href="@Url.Page("Index", new { page = halaman, q = Model.Search, kategori = Model.Category })">@halaman</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link" style="border:none;background:transparent;">. . .</span></li>
                }
            }
            <li class="page-item @(Model.Page >= Model.Products.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Page("Index", new { page = Model.Page + 1, q = Model.Search, kategori = Model.Category })" aria-label="Halaman berikutnya">
                    <span class="material-icons" style="font-size:18px;">chevron_right</span>
                </a>
            </li>
        </ul>
        <p class="text-center text-muted small mt-2 mb-0">Halaman @Model.Page dari @Model.Products.TotalPages</p>
    </nav>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-tambah-tamu').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = Number(btn.dataset.productId);
                    var items = bacaKeranjangTamu();
                    var ada = items.find(function (i) { return i.productId === id; });
                    if (ada) { ada.qty = (Number(ada.qty) || 0) + 1; }
                    else { items.push({ productId: id, qty: 1 }); }
                    simpanKeranjangTamu(items);
                    muatBadge();
                    Swal.fire({ toast: true, position: "top-end", icon: "success", title: "Ditambahkan ke keranjang.", showConfirmButton: false, timer: 1500 });
                });
            });
        });
    </script>
}