@using System.Security.Claims
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isDashboardPages = currentPage.Equals("/Panel", StringComparison.OrdinalIgnoreCase);
    var isProductPages = currentPage.StartsWith("/Panel/Produk", StringComparison.OrdinalIgnoreCase);
    var isMasterUserPages = currentPage.StartsWith("/Panel/MasterUser", StringComparison.OrdinalIgnoreCase);
    var isCategoryPages = currentPage.StartsWith("/Panel/Kategori", StringComparison.OrdinalIgnoreCase);
    var isUserControlPages = currentPage.StartsWith("/Panel/UserControl", StringComparison.OrdinalIgnoreCase);
    var isMonitoringPages = currentPage.StartsWith("/Panel/Monitoring", StringComparison.OrdinalIgnoreCase);
    var isSettingsPages = currentPage.StartsWith("/Panel/Settings", StringComparison.OrdinalIgnoreCase);
    var crumbRoot = ViewData["CrumbRoot"] as string
        ?? (isDashboardPages ? "Beranda"
            : isMasterUserPages ? "Master User"
            : isCategoryPages ? "Master Kategori"
            : isUserControlPages ? "User Control"
            : isMonitoringPages ? "Monitoring"
            : isSettingsPages ? "Pengaturan"
            : "Master Produk");
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isOwner = User.IsInRole("OWNER");
    var isAdmin = User.IsInRole("ADMIN");
    var isSa = User.IsInRole("SA");
    var currentRole = User.FindFirstValue(ClaimTypes.Role) ?? UserRolePolicy.Admin;
    var displayName = User.FindFirstValue("DisplayName") ?? User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Toko GKLaku</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --gk-primary: #4A7BA6;
            --gk-primary-hover: #3E6B93;
            --gk-primary-active: #35607F;
            --gk-primary-soft: #E3ECF4;
            --gk-primary-soft-hover: #D3E1EE;
            --gk-primary-text: #2C5A80;
            --gk-border: #B8CDE0;

            --bs-primary: var(--gk-primary);
            --bs-primary-rgb: 74, 123, 166;
            --bs-primary-text-emphasis: var(--gk-primary-text);
            --bs-primary-bg-subtle: var(--gk-primary-soft);
            --bs-primary-border-subtle: var(--gk-border);
            --bs-btn-primary-bg: var(--gk-primary);
            --bs-btn-primary-border-color: var(--gk-primary);
            --bs-btn-primary-hover-bg: var(--gk-primary-hover);
            --bs-btn-primary-hover-border-color: var(--gk-primary-hover);
            --bs-btn-primary-active-bg: var(--gk-primary-active);
            --bs-btn-primary-active-border-color: var(--gk-primary-active);
            --bs-btn-primary-disabled-bg: var(--gk-primary);
            --bs-btn-primary-disabled-border-color: var(--gk-primary);
            --bs-pagination-active-bg: var(--gk-primary);
            --bs-pagination-active-border-color: var(--gk-primary);
            --bs-link-color: var(--gk-primary);
            --bs-link-hover-color: var(--gk-primary-active);
            --bs-body-bg: #EEF1F4;
            --bs-body-color: #1F2937;
            --bs-body-font-size: 14px;
            --bs-body-font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        }

        body { min-height: 100vh; }
        .material-icons { vertical-align: middle; }
        .form-control { --bs-form-control-bg: #fff; background-color: #fff; }
        .form-select { --bs-form-select-bg: #fff; background-color: #fff; }
        .table { --bs-table-bg: #fff; background-color: #fff; }

        .app-shell { display: flex; min-height: 100vh; }
        .sidebar {
            width: 240px; flex-shrink: 0; background: #fff;
            border-right: 1px solid #E5EAE8; position: sticky; top: 0; height: 100vh;
            display: flex; flex-direction: column; padding: 20px 14px;
        }
        .sidebar-brand {
            display: flex; align-items: center; gap: 10px; padding: 0 10px 18px;
            font-weight: 700; font-size: 17px; color: #1F2937; text-decoration: none;
        }
        .sidebar-brand .brand-icon {
            display: inline-flex; align-items: center; justify-content: center;
            width: 36px; height: 36px; border-radius: 10px; background: var(--gk-primary); color: #fff;
        }
        .sidebar-brand .brand-icon .material-icons { font-size: 20px; }
        .nav-group-title {
            font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
            color: #9CA3AF; padding: 12px 10px 6px;
        }
        .sidebar .nav-link {
            display: flex; align-items: center; gap: 10px; padding: 9px 10px;
            border-radius: 8px; color: #334155; font-size: 14px; font-weight: 500;
        }
        .sidebar .nav-link .material-icons { font-size: 20px; color: #6B7280; }
        .sidebar .nav-link:hover { background: var(--bs-body-bg); color: #1F2937; }
        .sidebar .nav-link.active { background: var(--gk-primary-soft); color: var(--gk-primary-text); font-weight: 600; }
        .sidebar .nav-link.active .material-icons { color: var(--gk-primary); }
        .sidebar-footer { margin-top: auto; border-top: 1px solid #E5EAE8; padding-top: 12px; }

        .app-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
        .topbar {
            display: flex; align-items: center; gap: 12px; height: 56px; padding: 0 24px;
            background: #fff; border-bottom: 1px solid #E5EAE8; position: sticky; top: 0; z-index: 1020;
        }
        .content { flex: 1; padding: 24px; width: 100%; }
        .app-footer {
            display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
            padding: 10px 24px; background: #fff; border-top: 1px solid #E5EAE8;
            font-size: 12.5px; color: #6B7280;
        }

        .page-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
        .page-header h1 { margin: 0; font-size: 20px; font-weight: 700; }

        .card-soft { background: #fff; border: 1px solid #E5EAE8; border-radius: 12px; box-shadow: 0 1px 3px rgba(31, 41, 55, .05); }
        .stat-card .icon-box {
            display: inline-flex; align-items: center; justify-content: center;
            width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
        }
        .stat-card .icon-box .material-icons { font-size: 20px; }
        .stat-card .stat-value { font-size: 19px; font-weight: 700; line-height: 1.1; color: #1F2937; }
        .stat-card .stat-label { font-size: 12px; color: #6B7280; }
        .stat-card .card-body { padding: 12px 16px; }
        .icon-primary { background: var(--gk-primary-soft); color: var(--gk-primary); }
        .icon-warning { background: #FEF3C7; color: #B45309; }
        .icon-danger { background: #FEE2E2; color: #B42318; }
        .icon-info { background: #E0F2FE; color: #0369A1; }

        .th-sort {
            display: inline-flex; align-items: center; gap: 6px; width: 100%;
            border: none; background: none; font: inherit; font-weight: 600; cursor: pointer;
            color: #374151; padding: 4px 0; white-space: nowrap;
        }
        .th-sort:hover { color: var(--gk-primary); }
        .th-sort .sort-ic { font-size: 15px; color: #9CA3AF; }
        .th-sort.active { color: var(--gk-primary); }
        .th-sort.active .sort-ic { color: var(--gk-primary); }

        .td-price { white-space: nowrap; }
        .td-price .harga-coretan { display: block; text-decoration: line-through; color: #9CA3AF; font-size: 13px; }
        .td-price .harga-diskon { display: block; font-weight: 700; color: #B42318; }
        .td-nomor, .td-id, .td-ver { font-variant-numeric: tabular-nums; color: #6B7280; }

        .field-error { color: #B42318; font-size: .85em; display: block; margin-top: 4px; }
        .field-actions { display: flex; gap: 8px; }
        .btn-icon {
            display: inline-flex; align-items: center; justify-content: center;
            width: 32px; height: 32px; border-radius: 8px; text-decoration: none;
        }
        .btn-icon .material-icons { font-size: 18px; }
        .btn-edit { color: var(--gk-primary); background: var(--gk-primary-soft); }
        .btn-edit:hover { background: var(--gk-primary-soft-hover); }
        .btn-delete { color: #B42318; background: #FEE2E2; }
        .btn-delete:hover { background: #FECACA; }

        .pagination { margin-bottom: 0; gap: 4px; }
        .pagination .page-link {
            display: inline-flex; align-items: center; justify-content: center;
            min-width: 28px; height: 28px; padding: 0 6px; font-size: 12.5px;
        }
        .pagination .page-link .material-icons { font-size: 16px; }
        .pagination .page-item:not(:first-child) .page-link { margin-left: 0; }
        .pagination .page-item:first-child .page-link, .pagination .page-item:last-child .page-link { border-radius: 6px; }
        .pg-ellipsis { color: #6B7280; padding: 0 4px; }
        .row-loading, .row-empty { text-align: center; color: #6B7280; }
        .spinner-icon { display: inline-block; vertical-align: middle; animation: spin 1s linear infinite; font-size: 18px; }
        @@keyframes spin { 100% { transform: rotate(360deg); } }

        .search-box { max-width: 520px; }
        .filter-inline .w-num { width: 84px; }
        .filter-inline .w-date { width: 128px; }
        .filter-inline .cluster-label { font-size: 12px; line-height: 1.2; }
        .table-wrap { overflow-x: auto; }
        .table { font-size: 13px; }
        .table-data > :not(caption) > * > * { padding: 6px 10px; }
        .form-label { font-size: 13px; }
        .form-label.small { font-size: 12px; }
        table thead { background: var(--gk-primary-soft); }
        table thead th { color: var(--gk-primary-text); border-bottom: 2px solid var(--gk-border); }
        .search-box .material-icons { font-size: 16px; }
        .offcanvas-nav { width: 240px; }
        .offcanvas .sidebar-brand { padding: 0; }
        .offcanvas .nav-group-title { padding-left: 0; }
        .detail-k { width: 200px; }
        .rating-star { font-size: 15px; color: #F59E0B; }
        .col-no { width: 42px; min-width: 42px; }
        .col-aksi { width: 80px; min-width: 80px; }
        .table-data td.col-no, .table-data th.col-no, .table-data td.col-aksi, .table-data th.col-aksi { padding-left: 4px; padding-right: 4px; }
        th { white-space: nowrap; }
    </style>
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar d-none d-lg-flex">
            <a class="sidebar-brand" href="/Panel">
                <span class="brand-icon"><span class="material-icons">storefront</span></span>
                Toko GKLaku
            </a>
            <div class="sidebar-nav">
                @if (signedIn)
                {
                    <div class="nav-group-title">Beranda</div>
                    <a class="nav-link @(isDashboardPages ? "active" : "")" href="/Panel">
                        <span class="material-icons">dashboard</span> Dashboard
                    </a>
                    <div class="nav-group-title">Master</div>
                    <a class="nav-link @(isProductPages ? "active" : "")" href="/Panel/Produk">
                        <span class="material-icons">inventory_2</span> Master Produk
                    </a>
                    @if (isOwner || isSa)
                    {
                        <a class="nav-link @(isMasterUserPages ? "active" : "")" href="/Panel/MasterUser">
                            <span class="material-icons">group</span> Master User
                        </a>
                    }
                    @if (isAdmin || isOwner || isSa)
                    {
                        <a class="nav-link @(isCategoryPages ? "active" : "")" href="/Panel/Kategori">
                            <span class="material-icons">category</span> Master Kategori
                        </a>
                    }
                    @if (isOwner || isSa)
                    {
                        <div class="nav-group-title">Maintenance</div>
                        <a class="nav-link @(isUserControlPages ? "active" : "")" href="/Panel/UserControl">
                            <span class="material-icons">manage_accounts</span> User Control
                        </a>
                    }
                    <div class="nav-group-title">Monitoring</div>
                    <a class="nav-link @(isMonitoringPages ? "active" : "")" href="/Panel/Monitoring">
                        <span class="material-icons">fact_check</span> @(isOwner || isSa ? "Persetujuan Diskon" : "Permintaan Diskon Saya")
                    </a>
                    @if (isOwner || isSa)
                    {
                        <div class="nav-group-title">Settings</div>
                        @if (isSa)
                        {
                            <a class="nav-link @(currentPage == "/Panel/Settings/PengaturanAplikasi" ? "active" : "")" href="/Panel/Settings/PengaturanAplikasi">
                                <span class="material-icons">settings_applications</span> Pengaturan Aplikasi
                            </a>
                        }
                        <a class="nav-link @(currentPage == "/Panel/Settings/PengaturanToko" ? "active" : "")" href="/Panel/Settings/PengaturanToko">
                            <span class="material-icons">store</span> Pengaturan Toko
                        </a>
                    }
                }
            </div>
            <div class="sidebar-footer">
                <a class="nav-link" href="/swagger" target="_blank">
                    <span class="material-icons">api</span> Dokumentasi API
                </a>
            </div>
        </aside>

        <div class="app-main">
            <div class="topbar">
                <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#sidebarMobile" aria-label="Buka menu">
                    <span class="material-icons">menu</span>
                </button>
                @if (signedIn)
{
    <nav aria-label="breadcrumb" class="breadcrumb-nav">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="@(isDashboardPages ? "/Panel" : isMasterUserPages ? "/Panel/MasterUser" : isCategoryPages ? "/Panel/Kategori" : isUserControlPages ? "/Panel/UserControl" : isMonitoringPages ? "/Panel/Monitoring" : isSettingsPages ? "/Panel/Settings/PengaturanToko" : "/Panel/Produk")">@crumbRoot</a>
            </li>
            @if (!string.Equals(ViewData["Title"]?.ToString(), crumbRoot, StringComparison.OrdinalIgnoreCase))
            {
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            }
        </ol>
    </nav>
}
<div class="ms-auto d-flex align-items-center gap-2">
    @if (signedIn)
    {
        <span class="text-muted small">@displayName</span>
        <span class="badge @(isOwner || isSa ? "bg-dark" : "bg-primary-subtle text-primary-emphasis")">@UserRolePolicy.DisplayName(currentRole)</span>
        <a class="btn btn-outline-secondary btn-sm" href="/Panel/Keluar" title="Keluar">
            <span class="material-icons">logout</span>
        </a>
    }
</div>
            </div>

            <main class="content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© 2026 Toko GKLaku</span>
                <span class="text-muted">Razor Pages CRUD &mdash; ASP.NET Core (net10.0)</span>
            </footer>
        </div>
    </div>

    <div class="offcanvas offcanvas-start offcanvas-nav" tabindex="-1" id="sidebarMobile">
        <div class="offcanvas-header">
            <a class="sidebar-brand" href="/Panel">
                <span class="brand-icon"><span class="material-icons">storefront</span></span>
                Toko GKLaku
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Tutup"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            @if (signedIn)
            {
                <div class="nav-group-title">Beranda</div>
                <a class="nav-link @(isDashboardPages ? "active" : "")" href="/Panel">
                    <span class="material-icons">dashboard</span> Dashboard
                </a>
                <div class="nav-group-title">Master</div>
                <a class="nav-link @(isProductPages ? "active" : "")" href="/Panel/Produk">
                    <span class="material-icons">inventory_2</span> Master Produk
                </a>
                @if (isOwner || isSa)
                {
                    <a class="nav-link @(isMasterUserPages ? "active" : "")" href="/Panel/MasterUser">
                        <span class="material-icons">group</span> Master User
                    </a>
                }
                @if (isAdmin || isOwner || isSa)
                {
                    <a class="nav-link @(isCategoryPages ? "active" : "")" href="/Panel/Kategori">
                        <span class="material-icons">category</span> Master Kategori
                    </a>
                }
                @if (isOwner || isSa)
                {
                    <div class="nav-group-title">Maintenance</div>
                    <a class="nav-link @(isUserControlPages ? "active" : "")" href="/Panel/UserControl">
                        <span class="material-icons">manage_accounts</span> User Control
                    </a>
                }
                <div class="nav-group-title">Monitoring</div>
                <a class="nav-link @(isMonitoringPages ? "active" : "")" href="/Panel/Monitoring">
                    <span class="material-icons">fact_check</span> @(isOwner || isSa ? "Persetujuan Diskon" : "Permintaan Diskon Saya")
                </a>
                @if (isOwner || isSa)
                {
                    <div class="nav-group-title">Settings</div>
                    @if (isSa)
                    {
                        <a class="nav-link @(currentPage == "/Panel/Settings/PengaturanAplikasi" ? "active" : "")" href="/Panel/Settings/PengaturanAplikasi">
                            <span class="material-icons">settings_applications</span> Pengaturan Aplikasi
                        </a>
                    }
                    <a class="nav-link @(currentPage == "/Panel/Settings/PengaturanToko" ? "active" : "")" href="/Panel/Settings/PengaturanToko">
                        <span class="material-icons">store</span> Pengaturan Toko
                    </a>
                }
            }
            <div class="mt-auto">
                <a class="nav-link" href="/swagger" target="_blank">
                    <span class="material-icons">api</span> Dokumentasi API
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_ToastScriptsPartial" />
    <partial name="_PencarianDropdownScriptsPartial" />
</body>
</html>