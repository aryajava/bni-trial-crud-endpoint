<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Product Screen</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 0;
            background: #f4f6f9;
            color: #1f2937;
        }
        header {
            background: #0f2a5c;
            color: white;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            gap: 28px;
        }
        header a { color: white; text-decoration: none; font-weight: 600; }
        header nav { display: flex; gap: 16px; }
        main { max-width: 1280px; margin: 24px auto; padding: 0 16px; }
        footer { text-align: center; color: #6b7280; font-size: 13px; margin: 40px 0 16px; }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border: 1px solid #d9dee7;
        }
        th, td { padding: 8px 10px; border-bottom: 1px solid #e5e9f0; text-align: left; }
        th { background: #eef2f8; }

        .page-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; flex-wrap: wrap; }
        .page-header h1 { margin: 0; font-size: 22px; }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 8px;
            border: 1px solid transparent;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }
        .btn .material-icons { font-size: 18px; }
        .btn-utama { background: #1a56db; color: white; }
        .btn-utama:hover { background: #1648bb; }
        .btn-kedua { background: #e5e9f0; color: #1f2937; }
        .btn-kedua:hover { background: #d6dde8; }
        .btn-bahaya { background: #b91c1c; color: white; }
        .btn-bahaya:hover { background: #991b1b; }

        .form-card { max-width: 720px; background: white; padding: 24px 28px; border: 1px solid #d9dee7; border-radius: 12px; }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px 20px; }
        .form-field { display: flex; flex-direction: column; gap: 6px; }
        .form-field.full { grid-column: 1 / -1; }
        .form-field label { font-size: 13px; font-weight: 600; color: #374151; }
        .form-field input, .form-field select, .form-field textarea {
            width: 100%;
            padding: 9px 12px;
            border: 1px solid #c5ccd8;
            border-radius: 8px;
            font: inherit;
            background: #fff;
        }
        .form-field input:focus, .form-field select:focus, .form-field textarea:focus {
            outline: none;
            border-color: #1a56db;
            box-shadow: 0 0 0 3px rgba(26, 86, 219, .12);
        }
        .field-input-group { display: flex; align-items: stretch; border: 1px solid #c5ccd8; border-radius: 8px; background: #fff; overflow: hidden; }
        .field-input-group:focus-within { border-color: #1a56db; box-shadow: 0 0 0 3px rgba(26, 86, 219, .12); }
        .field-input-group .prefix { display: flex; align-items: center; padding: 0 14px; background: #eef2f8; border-right: 1px solid #c5ccd8; font-weight: 600; color: #4b5563; font-size: 13px; user-select: none; }
        .field-input-group .suffix { display: flex; align-items: center; padding: 0 12px; background: #eef2f8; border-left: 1px solid #c5ccd8; font-weight: 600; color: #4b5563; font-size: 13px; user-select: none; }
        .field-input-group input { flex: 1; min-width: 0; border: none !important; box-shadow: none !important; border-radius: 0 !important; }
        .form-actions { display: flex; gap: 10px; margin-top: 22px; flex-wrap: wrap; }

        .info-bar { display: flex; gap: 8px 20px; flex-wrap: wrap; background: #fff; border: 1px solid #d9dee7; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; max-width: 720px; }
        .info-bar .item { font-size: 13px; color: #4b5563; }
        .info-bar .item b { color: #1f2937; }

        .detail-card { max-width: 720px; background: white; border: 1px solid #d9dee7; border-radius: 12px; overflow: hidden; }
        .detail-card .row { display: grid; grid-template-columns: minmax(150px, 220px) 1fr; gap: 12px; padding: 12px 18px; border-bottom: 1px solid #eef2f6; }
        .detail-card .row:last-child { border-bottom: none; }
        .detail-card .row:nth-child(odd) { background: #fafbfd; }
        .detail-card .k { font-weight: 600; color: #6b7280; font-size: 13px; }
        .detail-card .v { color: #1f2937; }

        .banner-hapus { display: flex; align-items: center; gap: 10px; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 10px; margin: 16px 0; max-width: 720px; }
        .banner-hapus .material-icons { font-size: 22px; }

        .badge-stok { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; vertical-align: middle; }
        .badge-habis { background: #fee2e2; color: #b91c1c; }
        .badge-menipis { background: #fef3c7; color: #b45309; }
        .badge-tersedia { background: #dcfce7; color: #15803d; }

        .pesan-error {
            background: #fee2e2; color: #991b1b;
            padding: 10px 14px; border-radius: 8px; margin-bottom: 16px;
            border: 1px solid #fca5a5;
        }
        .validation-summary-valid { display: none; }
        .field-error { color: #b91c1c; font-size: 12px; }
    </style>
</head>
<body>
    <header>
        <strong>Product Screen</strong>
        <nav>
            <a asp-page="/Screen/Products/Index">Daftar Produk</a>
            <a asp-page="/Screen/Products/Create">Tambah Produk</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>Screen Razor Pages untuk CRUD produk &mdash; ASP.NET Core (net10.0)</footer>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>