<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Product Screen</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 0;
            background: #f4f6f9;
            color: #1f2937;
        }
        header {
            background: #0f2a5c;
            color: white;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            gap: 28px;
        }
        header a { color: white; text-decoration: none; font-weight: 600; }
        header nav { display: flex; gap: 16px; }
        main { max-width: 960px; margin: 24px auto; padding: 0 16px; }
        footer { text-align: center; color: #6b7280; font-size: 13px; margin: 40px 0 16px; }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border: 1px solid #d9dee7;
        }
        th, td { padding: 8px 10px; border-bottom: 1px solid #e5e9f0; text-align: left; }
        th { background: #eef2f8; }

        .btn {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 6px;
            border: 1px solid transparent;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }
        .btn-utama { background: #1a56db; color: white; }
        .btn-kedua { background: #e5e9f0; color: #1f2937; }
        .btn-bahaya { background: #b91c1c; color: white; }

        form.kartu { max-width: 640px; background: white; padding: 20px 24px; border: 1px solid #d9dee7; }
        form.kartu label { display: block; margin: 14px 0 4px; font-weight: 600; }
        form.kartu input, form.kartu textarea {
            width: 100%;
            padding: 7px 10px;
            border: 1px solid #c5ccd8;
            border-radius: 6px;
            font: inherit;
        }
        form.kartu .tombol { margin-top: 20px; }
        .pesan-sukses {
            background: #dcfce7; color: #166534;
            padding: 10px 14px; border-radius: 6px; margin-bottom: 16px;
            border: 1px solid #86efac;
        }
        .pesan-error {
            background: #fee2e2; color: #991b1b;
            padding: 10px 14px; border-radius: 6px; margin-bottom: 16px;
            border: 1px solid #fca5a5;
        }
        .field-error { color: #b91c1c; font-size: 13px; }
    </style>
</head>
<body>
    <header>
        <strong>Product Screen</strong>
        <nav>
            <a asp-page="/Screen/Products/Index">Daftar Produk</a>
            <a asp-page="/Screen/Products/Create">Tambah Produk</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>Screen Razor Pages untuk CRUD produk &mdash; ASP.NET Core (net10.0)</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>