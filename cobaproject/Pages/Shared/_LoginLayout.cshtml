@{
    var title = ViewData["Title"]?.ToString() ?? "Toko GKLaku";
}
<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Toko GKLaku</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
            min-height: 100vh;
            background: linear-gradient(160deg, #EEF1F4 0%, #DCE8F4 60%, #C9D9EC 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .card-login { width: 100%; max-width: 400px; border: 1px solid #E5EAE8; border-radius: 16px; box-shadow: 0 12px 32px rgba(31, 41, 55, .12); }
        .brand-icon {
            display: inline-flex; align-items: center; justify-content: center;
            width: 52px; height: 52px; border-radius: 14px; background: #4A7BA6; color: #fff;
        }
        .brand-icon .material-icons { font-size: 28px; }
        .input-group-text { background: #fff; }
        .btn-masuk { background: #4A7BA6; border-color: #4A7BA6; }
        .btn-masuk:hover { background: #3E6B93; border-color: #3E6B93; }
        .material-icons { vertical-align: middle; }
    </style>
</head>
<body>
    <div class="card card-login">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <span class="brand-icon mb-2"><span class="material-icons">storefront</span></span>
                <h1 class="h4 mb-1 fw-bold">Toko GKLaku</h1>
                <div class="text-muted small">Silakan masuk untuk melanjutkan</div>
            </div>

            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_ToastScriptsPartial" />
</body>
</html>