<script>
    (function () {
        var display = document.querySelector("input[data-bilangan]");
        if (!display) {
            return;
        }

        var max = display.getAttribute("data-bilangan-max");
        var maxVal = max === null ? null : parseInt(max, 10);

        function sync(teks) {
            var digit = teks.replace(/\D/g, "").slice(0, 9);
            var n = digit === "" ? 0 : parseInt(digit, 10);
            if (maxVal !== null && n > maxVal) {
                n = maxVal;
                digit = String(maxVal);
            }
            display.value = digit;
        }

        display.addEventListener("input", function () {
            sync(display.value);
        });

        display.addEventListener("keydown", function (e) {
            if (e.key === "-" || e.key === "+" || e.key === "e" || e.key === "E" ||
                e.key === "." || e.key === ",") {
                e.preventDefault();
            }
        });
    })();
</script>