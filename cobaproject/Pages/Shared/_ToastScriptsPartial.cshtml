@{
    string? pesanToast = null;
    string? ikonToast = null;
    var keJson = (string s) => System.Text.Json.JsonSerializer.Serialize(s);

    if (TempData["SuccessMessage"] is string sukses)
    {
        pesanToast = sukses;
        ikonToast = "success";
    }
    else if (TempData["ErrorMessage"] is string errorToast)
    {
        pesanToast = errorToast;
        ikonToast = "error";
    }
    else if (TempData["InfoMessage"] is string info)
    {
        pesanToast = info;
        ikonToast = "info";
    }
    else
    {
        var errorModel = ViewData.ModelState
            .Where(kv => kv.Key.Length == 0 && kv.Value?.Errors.Count > 0)
            .SelectMany(kv => kv.Value!.Errors)
            .Select(e => e.ErrorMessage)
            .FirstOrDefault(m => !string.IsNullOrWhiteSpace(m));
        if (errorModel is not null)
        {
            pesanToast = errorModel;
            ikonToast = "error";
        }
    }
}
<script>
    (function () {
        function tampilToast(ikon, judul, durasi) {
            if (window.Swal) {
                if (Swal.isVisible()) { Swal.close(); }
                Swal.fire({ toast: true, position: "top-end", icon: ikon, title: judul, showConfirmButton: false, timer: durasi, timerProgressBar: true });
            }
        }

        @if (pesanToast is not null)
        {
            @Html.Raw("tampilToast('" + ikonToast + "', " + keJson(pesanToast) + ", " + (ikonToast == "error" ? 5000 : 3000) + ");")
        }
    })();
</script>