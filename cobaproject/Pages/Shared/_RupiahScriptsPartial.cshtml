<script>
    (function () {
        var display = document.querySelector("input[data-rupiah]");
        if (!display) {
            return;
        }
        var hidden = document.querySelector('input[name="' + display.getAttribute("data-rupiah-target") + '"]');
        if (!hidden) {
            return;
        }

        function formatAngka(n) {
            return "Rp " + n.toLocaleString("id-ID", {
                maximumFractionDigits: 2
            });
        }

        function formatKetik(teks) {
            var digit = teks.replace(/\D/g, "");
            if (!digit) {
                display.value = "";
                hidden.value = "";
                return;
            }
            display.value = "Rp " + digit.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
            hidden.value = digit;
        }

        var awal = parseFloat(hidden.value);
        if (hidden.value.trim() !== "" && !isNaN(awal)) {
            display.value = formatAngka(awal);
        }

        display.addEventListener("input", function () {
            formatKetik(display.value);
        });

        display.addEventListener("focus", function () {
            if (display.value === "Rp ") {
                display.value = "";
            }
        });
    })();
</script>