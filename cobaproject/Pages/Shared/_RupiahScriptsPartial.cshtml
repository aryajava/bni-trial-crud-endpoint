<script>
    (function () {
        // Hidden input (Request.Price) membawa atribut data-val, tapi jQuery Validate
        // secara default mengabaikan elemen :hidden — aktifkan validasi untuk input
        // tersembunyi yang memiliki data-val agar Required/Range tetap jalan client-side.
        if (window.jQuery && jQuery.validator) {
            jQuery.validator.setDefaults({
                ignore: ':hidden:not([data-val])'
            });
        }

        var display = document.querySelector("input[data-rupiah]");
        if (!display) {
            return;
        }
        var hidden = document.querySelector('input[name="' + display.getAttribute("data-rupiah-target") + '"]');
        if (!hidden) {
            return;
        }

        function formatKetik(teks) {
            var digit = teks.replace(/\D/g, "");
            if (!digit) {
                display.value = "";
                hidden.value = "";
                return;
            }
            display.value = Number(digit).toLocaleString("id-ID");
            hidden.value = digit;
        }

        var awal = parseFloat(hidden.value);
        if (hidden.value.trim() !== "" && !isNaN(awal)) {
            display.value = awal.toLocaleString("id-ID", { maximumFractionDigits: 2 });
        }

        display.addEventListener("input", function () {
            formatKetik(display.value);
        });

        display.addEventListener("keydown", function (e) {
            if (e.key === "-" || e.key === "+" || e.key === "e" || e.key === "E") {
                e.preventDefault();
            }
        });
    })();
</script>