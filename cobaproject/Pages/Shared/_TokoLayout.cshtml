@using System.Security.Claims
@using cobaproject.Helpers
@using cobaproject.Services.Interfaces
@inject ICartService CartService
@{
    var isCustomer = User.Identity?.IsAuthenticated == true
        && string.Equals(User.Identity.AuthenticationType, CustomerAuth.CustomerScheme, StringComparison.OrdinalIgnoreCase);
    var namaAkun = isCustomer
        ? (User.FindFirstValue("DisplayName") ?? User.Identity!.Name ?? "")
        : "";
    var cartCountServer = 0;
    if (isCustomer && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var cid))
    {
        cartCountServer = CartService.CountAsync(cid).GetAwaiter().GetResult();
    }
    var title = ViewData["Title"]?.ToString() ?? "Toko GKLaku";
}
<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Toko GKLaku</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --gk-primary: #4A7BA6;
            --gk-primary-hover: #3E6B93;
            --gk-primary-soft: #E3ECF4;
            --gk-primary-text: #2C5A80;
            --gk-border: #B8CDE0;
            --bs-primary: var(--gk-primary);
            --bs-primary-rgb: 74, 123, 166;
        }
        body { font-family: 'Inter', 'Segoe UI', Arial, sans-serif; background: #F4F6F8; color: #1F2937; }
        .material-icons { vertical-align: middle; }
        .toko-navbar { background: #fff; border-bottom: 1px solid #E5EAE8; position: sticky; top: 0; z-index: 1000; }
        .toko-navbar .navbar-brand { font-weight: 700; color: var(--gk-primary-text); }
        .toko-footer { border-top: 1px solid #E5EAE8; background: #fff; }
        .card-produk { height: 100%; transition: box-shadow .15s ease; }
        .card-produk:hover { box-shadow: 0 10px 24px rgba(31, 41, 55, .1); }
        .card-produk .img-wrap { height: 180px; display: flex; align-items: center; justify-content: center; background: #fff; overflow: hidden; }
        .card-produk .img-wrap img { max-height: 100%; max-width: 100%; object-fit: contain; }
        .harga-asli { text-decoration: line-through; color: #6B7280; font-size: 13px; }
        .harga-efektif { color: var(--gk-primary-text); font-weight: 700; font-size: 17px; }
        .badge-diskon { position: absolute; top: 10px; left: 10px; background: #F59E0B; color: #fff; font-size: 12px; }
        .badge-habis { position: absolute; top: 10px; right: 10px; }
        .field-error { color: #B42318; font-size: .85em; display: block; margin-top: 4px; }
        .pesan-error { color: #B42318; font-size: .85em; }
        .btn-masuk { background: var(--gk-primary); border-color: var(--gk-primary); color: #fff; }
        .btn-masuk:hover { background: var(--gk-primary-hover); border-color: var(--gk-primary-hover); color: #fff; }
    </style>
</head>
<body>
    <nav class="toko-navbar">
        <div class="container py-2 d-flex align-items-center gap-3">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <span class="material-icons" style="color: var(--gk-primary);">storefront</span> Toko GKLaku
            </a>
            <form method="get" action="/" class="d-flex flex-grow-1" style="max-width: 420px;" role="search">
                <div class="input-group input-group-sm">
                    <input type="text" name="q" value="@ViewContext.HttpContext.Request.Query["q"]" class="form-control" placeholder="Cari produk..." autocomplete="off" />
                    <button class="btn btn-outline-secondary" type="submit" aria-label="Cari"><span class="material-icons">search</span></button>
                </div>
            </form>
            <div class="ms-auto d-flex align-items-center gap-2">
                <a class="btn btn-outline-secondary btn-sm position-relative" href="/Keranjang" title="Keranjang">
                    <span class="material-icons">shopping_cart</span>
                    @if (isCustomer && cartCountServer > 0)
                    {
                        <span class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill">@cartCountServer</span>
                    }
                    else
                    {
                        <span class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill" id="cartBadge" style="display:none;">0</span>
                    }
                </a>
                @if (isCustomer)
                {
                    <div class="dropdown">
                        <button class="btn btn-sm btn-masuk dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="material-icons">account_circle</span> @namaAkun
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/PesananSaya"><span class="material-icons">receipt_long</span> Pesanan Saya</a></li>
                            <li><a class="dropdown-item" href="/Profil"><span class="material-icons">manage_accounts</span> Profil Saya</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="/Keluar"><span class="material-icons">logout</span> Keluar</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-sm btn-masuk" href="/Masuk"><span class="material-icons">login</span> Masuk</a>
                }
            </div>
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="toko-footer py-3 mt-4">
        <div class="container d-flex justify-content-between small text-muted">
            <span>&copy; 2026 Toko GKLaku</span>
            <span>Toko online trial</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const PELANGGAN_MASUK = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isCustomer));

        function bacaKeranjangTamu() {
            try {
                return JSON.parse(localStorage.getItem('gklaku_cart') || '[]');
            } catch (e) { return []; }
        }
        function simpanKeranjangTamu(items) {
            localStorage.setItem('gklaku_cart', JSON.stringify(items));
        }
        function hitungTamu() {
            return bacaKeranjangTamu().length;
        }
        function muatBadge() {
            if (PELANGGAN_MASUK) return;
            var n = hitungTamu();
            var b = document.getElementById('cartBadge');
            if (b) { b.style.display = n > 0 ? '' : 'none'; b.textContent = n; }
        }
        document.addEventListener('DOMContentLoaded', muatBadge);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_ToastScriptsPartial" />
</body>
</html>