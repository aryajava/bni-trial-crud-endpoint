@using System.Security.Claims
@using cobaproject.Helpers
@using cobaproject.Services.Interfaces
@inject ICartService CartService
@{
    var isCustomer = User.Identity?.IsAuthenticated == true
        && string.Equals(User.Identity.AuthenticationType, CustomerAuth.CustomerScheme, StringComparison.OrdinalIgnoreCase);
    var namaAkun = isCustomer
        ? (User.FindFirstValue("DisplayName") ?? User.Identity!.Name ?? "")
        : "";
    var cartCountServer = 0;
    if (isCustomer && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var cid))
    {
        cartCountServer = CartService.CountAsync(cid).GetAwaiter().GetResult();
    }
    var title = ViewData["Title"]?.ToString() ?? "Toko GKLaku";
}
<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Toko GKLaku</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        @* Satu aksen: biru toko (#4A7BA6). Radius konsisten: badge pill, kartu 14px, tombol & input 10px. *@
        :root {
            --gk-primary: #4A7BA6;
            --gk-primary-hover: #3E6B93;
            --gk-primary-soft: #E8F0F6;
            --gk-primary-text: #2C5A80;
            --gk-border: #DFE4E9;
            --gk-surface: #F5F6F8;
            --gk-muted: #6B7380;
            --bs-primary: var(--gk-primary);
            --bs-primary-rgb: 74, 123, 166;
        }
        body { font-family: 'Outfit', 'Segoe UI', Arial, sans-serif; background: var(--gk-surface); color: #232A31; }
        .material-icons { vertical-align: middle; }
        .toko-navbar {
            background: rgba(255, 255, 255, .92);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--gk-border);
            position: sticky; top: 0; z-index: 1000;
            min-height: 60px;
        }
        .toko-navbar .navbar-brand { font-weight: 700; color: var(--gk-primary-text); letter-spacing: -0.01em; }
        .toko-navbar .form-control, .toko-navbar .btn { border-radius: 10px; }
        .toko-footer { border-top: 1px solid var(--gk-border); background: #fff; color: #5B6470; }
        .card-toko { border: 1px solid var(--gk-border); border-radius: 14px; box-shadow: 0 1px 2px rgba(31, 41, 55, .04); }
        .card-produk {
            height: 100%;
            border: 1px solid var(--gk-border);
            border-radius: 14px;
            background: #fff;
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .card-produk:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(74, 123, 166, .12); }
        .card-produk .img-wrap {
            aspect-ratio: 4 / 3;
            display: flex; align-items: center; justify-content: center;
            background: #FAFBFC; border-bottom: 1px solid var(--gk-border);
            overflow: hidden; border-radius: 14px 14px 0 0;
        }
        .card-produk .img-wrap img { max-height: 100%; max-width: 100%; object-fit: contain; }
        .judul-produk { font-weight: 600; color: #232A31; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.7em; }
        .harga-asli { text-decoration: line-through; color: var(--gk-muted); font-size: 13px; }
        .harga-efektif { color: var(--gk-primary-text); font-weight: 700; font-size: 17px; letter-spacing: -0.01em; }
        .badge-diskon {
            position: absolute; top: 8px; left: 8px;
            background: #FFF3D6; color: #8A5A00; border: 1px solid #F2DCA8;
            font-size: 12px; font-weight: 600; border-radius: 999px; padding: 2px 8px;
        }
        .badge-habis { position: absolute; top: 8px; right: 8px; border-radius: 999px; }
        .field-error { color: #B42318; font-size: .85em; display: block; margin-top: 4px; }
        .pesan-error { color: #B42318; font-size: .85em; }
        .btn-masuk { background: var(--gk-primary); border-color: var(--gk-primary); color: #fff; border-radius: 10px; }
        .btn-masuk:hover { background: var(--gk-primary-hover); border-color: var(--gk-primary-hover); color: #fff; }
        .fil-kategori {
            display: flex; align-items: center; justify-content: space-between;
            width: 100%; text-align: left;
            border: 1px solid transparent; border-radius: 10px;
            padding: 7px 10px; color: #3A4350; font-size: 14px;
            background: transparent; transition: background .12s ease;
        }
        .fil-kategori:hover { background: #EEF2F6; }
        .fil-kategori.aktif { background: var(--gk-primary-soft); color: var(--gk-primary-text); font-weight: 600; border-color: #C9D9E8; }
        .fil-kategori .jml { font-size: 12px; color: var(--gk-muted); }
        .chip-kategori {
            white-space: nowrap; border: 1px solid var(--gk-border); border-radius: 999px;
            padding: 5px 12px; font-size: 13px; color: #3A4350; background: #fff;
        }
        .chip-kategori.aktif { background: var(--gk-primary); border-color: var(--gk-primary); color: #fff; }
        .pagination-toko { gap: 4px; }
        .pagination-toko .page-link {
            display: inline-flex; align-items: center; justify-content: center;
            min-width: 36px; height: 36px; border-radius: 10px;
            color: #3A4350; border: 1px solid var(--gk-border); background: #fff;
        }
        .pagination-toko .page-item.active .page-link { background: var(--gk-primary); border-color: var(--gk-primary); color: #fff; }
        .pagination-toko .page-item.disabled .page-link { color: #B7BEC7; background: #F1F3F5; }
        .ringkasan-total { font-size: 20px; font-weight: 700; letter-spacing: -0.01em; }
        @@media (prefers-reduced-motion: reduce) {
            .card-produk { transition: none; }
            .card-produk:hover { transform: none; }
        }
    </style>
</head>
<body>
    <nav class="toko-navbar">
        <div class="container d-flex align-items-center gap-3" style="min-height:60px;">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <span class="material-icons" style="color: var(--gk-primary);">storefront</span><span>Toko GKLaku</span>
            </a>
            <form method="get" action="/" class="d-none d-md-flex flex-grow-1" style="max-width: 420px;" role="search">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius:10px 0 0 10px;"><span class="material-icons" style="font-size:18px;color:#8A929C;">search</span></span>
                    <input type="text" name="q" value="@ViewContext.HttpContext.Request.Query["q"]" class="form-control border-start-0" placeholder="Cari produk..." autocomplete="off" style="border-radius:0 10px 10px 0;" />
                </div>
            </form>
            <div class="ms-auto d-flex align-items-center gap-2">
                <a class="btn btn-outline-secondary btn-sm position-relative" href="/Keranjang" title="Keranjang" style="border-radius:10px;">
                    <span class="material-icons">shopping_cart</span>
                    @if (isCustomer && cartCountServer > 0)
                    {
                        <span class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill">@cartCountServer</span>
                    }
                    else
                    {
                        <span class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill" id="cartBadge" style="display:none;">0</span>
                    }
                </a>
                @if (isCustomer)
                {
                    <div class="dropdown">
                        <button class="btn btn-sm btn-masuk dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="material-icons">account_circle</span> @namaAkun
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/PesananSaya"><span class="material-icons">receipt_long</span> Pesanan Saya</a></li>
                            <li><a class="dropdown-item" href="/Profil"><span class="material-icons">manage_accounts</span> Profil Saya</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="/Keluar"><span class="material-icons">logout</span> Keluar</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-sm btn-masuk" href="/Masuk"><span class="material-icons">login</span> Masuk</a>
                }
            </div>
        </div>
    </nav>

    <main class="container py-4 pb-5">
        @RenderBody()
    </main>

    <footer class="toko-footer">
        <div class="container py-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="fw-bold" style="color: var(--gk-primary-text);">
                        <span class="material-icons" style="vertical-align:-4px;">storefront</span> Toko GKLaku
                    </div>
                    <p class="small mb-0 mt-1" style="color: var(--gk-muted);">Belanja mudah, dikirim dengan ekspedisi pilihanmu.</p>
                </div>
                <nav class="d-flex flex-wrap gap-3 small" aria-label="Tautan toko">
                    <a class="text-decoration-none" style="color:#3A4350;" href="/">Katalog</a>
                    <a class="text-decoration-none" style="color:#3A4350;" href="/Keranjang">Keranjang</a>
                    @if (isCustomer)
                    {
                        <a class="text-decoration-none" style="color:#3A4350;" href="/PesananSaya">Pesanan Saya</a>
                    }
                    else
                    {
                        <a class="text-decoration-none" style="color:#3A4350;" href="/Masuk">Masuk</a>
                    }
                </nav>
            </div>
            <hr class="mt-3 mb-2" style="border-color: var(--gk-border);" />
            <div class="d-flex flex-column flex-sm-row justify-content-between gap-1 small" style="color: var(--gk-muted);">
                <span>&copy; 2026 Toko GKLaku</span>
                <span>Toko online trial</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const PELANGGAN_MASUK = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isCustomer));

        function bacaKeranjangTamu() {
            try {
                return JSON.parse(localStorage.getItem('gklaku_cart') || '[]');
            } catch (e) { return []; }
        }
        function simpanKeranjangTamu(items) {
            localStorage.setItem('gklaku_cart', JSON.stringify(items));
        }
        function hitungTamu() {
            return bacaKeranjangTamu().length;
        }
        function muatBadge() {
            if (PELANGGAN_MASUK) return;
            var n = hitungTamu();
            var b = document.getElementById('cartBadge');
            if (b) { b.style.display = n > 0 ? '' : 'none'; b.textContent = n; }
        }
        document.addEventListener('DOMContentLoaded', muatBadge);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_ToastScriptsPartial" />
</body>
</html>