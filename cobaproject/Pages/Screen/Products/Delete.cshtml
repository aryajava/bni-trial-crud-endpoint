@page "{id:int}"
@model cobaproject.Pages.Screen.Products.DeleteModel
@{
    ViewData["Title"] = "Hapus Produk";
    var idId = System.Globalization.CultureInfo.GetCultureInfo("id-ID");
    decimal? hargaEfektif = Model.Product is null ? null
        : (Model.Product.DiscountPercent ?? 0) == 0
            ? Model.Product.Price
            : Math.Round((Model.Product.Price - Model.Product.Price * (Model.Product.DiscountPercent ?? 0) / 100m) / 100m,
                MidpointRounding.AwayFromZero) * 100m;
}

<div class="page-header">
    <h1>Hapus Produk #@Model.Product?.Id</h1>
    <a class="btn btn-kedua" asp-page="Index"><span class="material-icons">arrow_back</span> Kembali</a>
</div>

@if (Model.Product is null)
{
    <div class="pesan-error"><span class="material-icons" style="vertical-align: middle;">search_off</span> Produk tidak ditemukan.</div>
    <a class="btn btn-kedua" asp-page="Index"><span class="material-icons">arrow_back</span> Kembali ke daftar</a>
}
else
{
    <div class="detail-card">
        <div class="row"><div class="k">ID</div><div class="v">@Model.Product.Id</div></div>
        <div class="row"><div class="k">Judul</div><div class="v">@Model.Product.Title</div></div>
        <div class="row"><div class="k">Harga</div>
            <div class="v">@Model.Product.Price.ToString("C2", idId)</div></div>
        <div class="row"><div class="k">Kategori</div><div class="v">@(Model.Product.Category ?? "-")</div></div>
        <div class="row"><div class="k">Rating</div>
            <div class="v">@(Model.Product.RatingRate?.ToString("0.0", idId) ?? "-") (@(Model.Product.RatingCount?.ToString() ?? "-"))</div></div>
        <div class="row"><div class="k">Diskon</div><div class="v">@(Model.Product.DiscountPercent.HasValue ? $"{Model.Product.DiscountPercent}%" : "-")</div></div>
        <div class="row"><div class="k">Harga Setelah Diskon</div>
            <div class="v">@((Model.Product.DiscountPercent ?? 0) == 0
                ? Model.Product.Price.ToString("C2", idId)
                : hargaEfektif?.ToString("C0", idId))</div></div>
        <div class="row"><div class="k">Dibuat</div><div class="v">@Model.Product.CreatedAt.ToString("dd MMM yyyy HH:mm", idId)</div></div>
        <div class="row"><div class="k">Diubah</div><div class="v">@(Model.Product.UpdatedAt?.ToString("dd MMM yyyy HH:mm", idId) ?? "-")</div></div>
        <div class="row"><div class="k">Versi</div><div class="v">@Model.Product.Version</div></div>
    </div>

    <div class="banner-hapus">
        <span class="material-icons">warning</span>
        <span>Yakin ingin menghapus produk <strong>@Model.Product.Title</strong>? Tindakan ini tidak dapat dibatalkan.</span>
    </div>

    <form method="post">
        <div class="form-actions">
            <button class="btn btn-bahaya" type="submit"><span class="material-icons">delete</span> Hapus (soft delete)</button>
            <button class="btn btn-bahaya" type="submit" asp-page-handler="Hard"><span class="material-icons">delete_forever</span> Hapus permanen</button>
            <a class="btn btn-kedua" asp-page="Index"><span class="material-icons">close</span> Batal</a>
        </div>
    </form>
}