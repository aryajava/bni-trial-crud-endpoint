@page
@model cobaproject.Pages.Screen.Products.CreateModel
@{
    ViewData["Title"] = "Tambah Produk";
}

<div class="page-header">
    <h1>Tambah Produk</h1>
    <a class="btn btn-kedua" asp-page="Index"><span class="material-icons">arrow_back</span> Kembali</a>
</div>

<form class="form-card" method="post">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="pesan-error"></div>
    }

    <div class="form-grid">
        <div class="form-field full">
            <label asp-for="Request.Title">Judul</label>
            <input asp-for="Request.Title" />
            <span asp-validation-for="Request.Title" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Request.Category">Kategori</label>
            <select asp-for="Request.Category">
                <option value="" selected disabled>Pilih Kategori</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
            <span asp-validation-for="Request.Category" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Request.Price">Harga</label>
            <div class="field-input-group">
                <span class="prefix">Rp</span>
                <input data-rupiah data-rupiah-target="Request.Price" inputmode="decimal" />
            </div>
            <input asp-for="Request.Price" type="hidden" />
            <span asp-validation-for="Request.Price" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Request.DiscountPercent">Diskon</label>
            <div class="field-input-group">
                <input asp-for="Request.DiscountPercent" data-bilangan data-bilangan-max="100" inputmode="numeric" />
                <span class="suffix">%</span>
            </div>
            <span asp-validation-for="Request.DiscountPercent" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Request.RatingRate">Rating</label>
            <input asp-for="Request.RatingRate" />
        </div>

        <div class="form-field">
            <label asp-for="Request.RatingCount">Jumlah Rating</label>
            <input asp-for="Request.RatingCount" />
        </div>

        <div class="form-field">
            <label asp-for="Request.Stock">Stok</label>
            <input asp-for="Request.Stock" data-bilangan inputmode="numeric" />
            <span asp-validation-for="Request.Stock" class="field-error"></span>
        </div>

        <div class="form-field full">
            <label asp-for="Request.Image">URL Gambar</label>
            <input asp-for="Request.Image" />
        </div>

        <div class="form-field full">
            <label asp-for="Request.Description">Deskripsi</label>
            <textarea asp-for="Request.Description" rows="4"></textarea>
        </div>
    </div>

    <div class="form-actions">
        <button class="btn btn-utama" type="submit"><span class="material-icons">save</span> Simpan</button>
        <a class="btn btn-kedua" asp-page="Index"><span class="material-icons">close</span> Batal</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RupiahScriptsPartial" />
    <partial name="_BilanganScriptsPartial" />
}
