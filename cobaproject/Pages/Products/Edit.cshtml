@page "{id:int}"
@model cobaproject.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit Produk";
}

<div class="page-header">
    <h1>Edit Produk #@Model.Id</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-page="Index"><span class="material-icons">arrow_back</span> Kembali</a>
</div>

<div class="d-flex gap-4 flex-wrap mb-3">
    <span class="badge bg-primary-subtle text-primary-emphasis">ID: @Model.Id</span>
    <span class="badge bg-secondary-subtle text-secondary-emphasis">Versi: @Model.Request.Version</span>
</div>

<div class="card card-soft">
    <div class="card-body p-3">
        <form method="post">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label" asp-for="Request.Title">Judul</label>
                    <input asp-for="Request.Title" class="form-control form-control-sm" />
                    <span asp-validation-for="Request.Title" class="field-error"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" asp-for="Request.CategoryId">Kategori</label>
                    <select asp-for="Request.CategoryId" class="form-select form-select-sm">
                        <option value="" disabled>Pilih Kategori</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Request.CategoryId" class="field-error"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" asp-for="Request.Price">Harga</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light">Rp</span>
                        <input data-rupiah data-rupiah-target="Request.Price" inputmode="decimal" class="form-control form-control-sm" />
                    </div>
                    <input asp-for="Request.Price" type="hidden" />
                    <span asp-validation-for="Request.Price" class="field-error"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" asp-for="Request.DiscountPercent">Diskon</label>
                    <div class="input-group input-group-sm">
                        <input asp-for="Request.DiscountPercent" data-bilangan data-bilangan-desimal data-bilangan-max="100" inputmode="decimal" class="form-control form-control-sm" />
                        <span class="input-group-text bg-light">%</span>
                    </div>
                    <span asp-validation-for="Request.DiscountPercent" class="field-error"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" asp-for="Request.Stock">Stok</label>
                    <input asp-for="Request.Stock" data-bilangan inputmode="numeric" class="form-control form-control-sm" />
                    <span asp-validation-for="Request.Stock" class="field-error"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" asp-for="Request.RatingRate">Rating</label>
                    <input asp-for="Request.RatingRate" data-bilangan data-bilangan-desimal data-bilangan-max="5" inputmode="decimal" class="form-control form-control-sm" />
                    <span asp-validation-for="Request.RatingRate" class="field-error"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" asp-for="Request.RatingCount">Jumlah Rating</label>
                    <input asp-for="Request.RatingCount" data-bilangan inputmode="numeric" class="form-control form-control-sm" />
                    <span asp-validation-for="Request.RatingCount" class="field-error"></span>
                </div>

                <div class="col-12">
                    <label class="form-label" asp-for="Request.Image">URL Gambar</label>
                    <input asp-for="Request.Image" class="form-control form-control-sm" />
                </div>

                <div class="col-12">
                    <label class="form-label" asp-for="Request.Description">Deskripsi</label>
                    <textarea asp-for="Request.Description" class="form-control form-control-sm" rows="4"></textarea>
                </div>
            </div>

            <input type="hidden" asp-for="Request.Version" />

            <div class="mt-4 d-flex gap-2 flex-wrap">
                <button class="btn btn-primary btn-sm" type="submit"><span class="material-icons">save</span> Simpan</button>
                <a class="btn btn-outline-secondary btn-sm" asp-page="Index"><span class="material-icons">close</span> Batal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RupiahScriptsPartial" />
    <partial name="_BilanganScriptsPartial" />
}
