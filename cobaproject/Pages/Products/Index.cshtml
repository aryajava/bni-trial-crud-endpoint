@page
@model cobaproject.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Master Produk";
}

<div class="page-header">
    <h1>Master Produk</h1>
    <a class="btn btn-primary btn-sm" asp-page="Create"><span class="material-icons">add</span> Tambah Produk</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card card-soft stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="icon-box icon-primary"><span class="material-icons">inventory_2</span></span>
                <div>
                    <div class="stat-value">@Model.Stats.Total</div>
                    <div class="stat-label">Total Produk</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-soft stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="icon-box icon-info"><span class="material-icons">percent</span></span>
                <div>
                    <div class="stat-value">@Model.Stats.Discounted</div>
                    <div class="stat-label">Produk Diskon</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-soft stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="icon-box icon-warning"><span class="material-icons">warning_amber</span></span>
                <div>
                    <div class="stat-value">@Model.Stats.LowStock</div>
                    <div class="stat-label">Stok Menipis (1–5)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-soft stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="icon-box icon-danger"><span class="material-icons">block</span></span>
                <div>
                    <div class="stat-value">@Model.Stats.OutOfStock</div>
                    <div class="stat-label">Stok Habis</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mb-2">
    <div class="input-group input-group-sm search-box">
        <span class="input-group-text bg-white"><span class="material-icons">search</span></span>
        <input type="text" id="searchInput" class="form-control" placeholder="Cari di semua kolom..." autocomplete="off" />
    </div>
</div>

<div class="filter-inline d-flex flex-wrap align-items-end gap-2 mb-3">
    <div class="d-flex flex-column gap-1">
        <label class="cluster-label text-secondary fw-semibold mb-0" for="categorySelect">Kategori</label>
        <select id="categorySelect" class="form-select form-select-sm">
            <option value="">Semua Kategori</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c">@c</option>
            }
        </select>
    </div>
    <div class="d-flex flex-column gap-1">
        <label class="cluster-label text-secondary fw-semibold mb-0">Harga (Rp)</label>
        <div class="d-flex align-items-center gap-1">
            <input type="number" id="priceMin" class="form-control form-control-sm w-num" placeholder="Min" min="0" step="0.01" />
            <span class="text-secondary">–</span>
            <input type="number" id="priceMax" class="form-control form-control-sm w-num" placeholder="Max" min="0" step="0.01" />
        </div>
    </div>
    <div class="d-flex flex-column gap-1">
        <label class="cluster-label text-secondary fw-semibold mb-0">Stok</label>
        <div class="d-flex align-items-center gap-1">
            <input type="number" id="stockMin" class="form-control form-control-sm w-num" placeholder="Min" min="0" step="1" />
            <span class="text-secondary">–</span>
            <input type="number" id="stockMax" class="form-control form-control-sm w-num" placeholder="Max" min="0" step="1" />
        </div>
    </div>
    <div class="d-flex flex-column gap-1">
        <label class="cluster-label text-secondary fw-semibold mb-0">Dibuat</label>
        <div class="d-flex align-items-center gap-1">
            <input type="date" id="createdFrom" class="form-control form-control-sm w-date" />
            <span class="text-secondary">–</span>
            <input type="date" id="createdTo" class="form-control form-control-sm w-date" />
        </div>
    </div>
    <div class="d-flex flex-column gap-1">
        <label class="cluster-label text-secondary fw-semibold mb-0">Diubah</label>
        <div class="d-flex align-items-center gap-1">
            <input type="date" id="updatedFrom" class="form-control form-control-sm w-date" />
            <span class="text-secondary">–</span>
            <input type="date" id="updatedTo" class="form-control form-control-sm w-date" />
        </div>
    </div>
    <button class="btn btn-outline-secondary btn-sm" id="resetFilter"><span class="material-icons">restart_alt</span> Reset</button>
</div>

<div class="card card-soft">
    <div class="table-wrap">
        <table class="table table-hover table-data align-middle mb-0">
            <thead>
                <tr>
                    <th class="col-no text-center">No.</th>
                    <th class="col-aksi text-center">Aksi</th>
                    <th><button class="th-sort" data-sort="id">ID<span class="material-icons sort-ic">swap_vert</span></button></th>
                    <th><button class="th-sort" data-sort="title">Judul<span class="material-icons sort-ic">swap_vert</span></button></th>
                    <th><button class="th-sort" data-sort="price" title="Sortir berdasarkan harga efektif (setelah diskon)">Harga<span class="material-icons sort-ic">swap_vert</span></button></th>
                    <th><button class="th-sort" data-sort="category">Kategori<span class="material-icons sort-ic">swap_vert</span></button></th>
                    <th><button class="th-sort" data-sort="ratingRate">Rating<span class="material-icons sort-ic">swap_vert</span></button></th>
                    <th><button class="th-sort" data-sort="stock">Stok<span class="material-icons sort-ic">swap_vert</span></button></th>
                    <th><button class="th-sort" data-sort="createdBy">Dibuat Oleh<span class="material-icons sort-ic">swap_vert</span></button></th>
                    <th><button class="th-sort" data-sort="createdAt">Dibuat<span class="material-icons sort-ic">swap_vert</span></button></th>
                    <th><button class="th-sort" data-sort="updatedBy">Diubah Oleh<span class="material-icons sort-ic">swap_vert</span></button></th>
                    <th><button class="th-sort" data-sort="updatedAt">Diubah<span class="material-icons sort-ic">swap_vert</span></button></th>
                    <th><button class="th-sort" data-sort="version">Versi<span class="material-icons sort-ic">swap_vert</span></button></th>
                </tr>
            </thead>
            <tbody id="productRows">
                <tr class="row-loading"><td colspan="13"><span class="material-icons spinner-icon">autorenew</span> Memuat data...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="card-body border-top d-flex align-items-center justify-content-between gap-3 flex-wrap py-2 px-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <select id="pageSizeSelect" class="form-select form-select-sm w-auto">
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <span class="text-secondary small">data / halaman</span>
            <span id="pageInfo" class="text-muted small">Hal 0 dari 0 (0 data)</span>
        </div>
        <nav><ul class="pagination pagination-sm" id="pagination"></ul></nav>
    </div>
</div>

@section Scripts {
    <script>
        const API_KEY_HEADER = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApiKeyHeader));
        const API_KEY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApiKey));

        const state = {
            page: 1,
            pageSize: 20,
            sortBy: '',
            sortOrder: 'asc',
            search: '',
            category: '',
            priceMin: '',
            priceMax: '',
            stockMin: '',
            stockMax: '',
            createdFrom: '',
            createdTo: '',
            updatedFrom: '',
            updatedTo: '',
            totalPages: 0
        };

        const $ = (id) => document.getElementById(id);

        function esc(s) {
            return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function formatRupiah(v) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(v);
        }

        function formatRupiahBulat(v) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(v);
        }

        function renderHarga(item) {
            const asli = formatRupiah(item.price);
            const disc = item.discountPercent ?? 0;
            if (disc <= 0) return asli;
            const efektif = Math.round((item.price - item.price * disc / 100) / 100) * 100;
            return `<span class="harga-coretan">${asli}</span><span class="harga-diskon">${formatRupiahBulat(efektif)}</span>`;
        }

        function renderRating(item) {
            if (item.ratingRate == null) return '-';
            return `<div class="d-flex flex-column align-items-start">
                <span class="fw-semibold"><span class="material-icons rating-star">star</span> ${Number(item.ratingRate).toFixed(1)}</span>
                <span class="text-muted small">(${item.ratingCount ?? 0})</span>
            </div>`;
        }

        function renderStok(item) {
            const s = item.stock ?? 0;
            const cls = s <= 0 ? 'bg-danger-subtle text-danger-emphasis'
                : s <= 5 ? 'bg-warning-subtle text-warning-emphasis'
                : 'bg-success-subtle text-success-emphasis';
            const lbl = s <= 0 ? 'Habis' : s <= 5 ? 'Menipis' : 'Tersedia';
            return `<div class="d-flex flex-column align-items-start">
                <span class="fw-semibold">${s}</span>
                <span class="badge ${cls}">${lbl}</span>
            </div>`;
        }

        function formatDateTime(iso) {
            if (!iso) return '-';
            const d = new Date(iso);
            if (isNaN(d)) return '-';
            return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) +
                ', ' + d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
        }

        function buildQuery() {
            const q = new URLSearchParams();
            q.set('page', state.page);
            q.set('pageSize', state.pageSize);
            if (state.sortBy) {
                q.set('sortBy', state.sortBy);
                q.set('sortOrder', state.sortOrder);
            }
            if (state.search.trim()) q.set('search', state.search.trim());
            if (state.category) q.set('category', state.category);
            if (state.priceMin !== '') q.set('priceFrom', state.priceMin);
            if (state.priceMax !== '') q.set('priceTo', state.priceMax);
            if (state.stockMin !== '') q.set('stockFrom', state.stockMin);
            if (state.stockMax !== '') q.set('stockTo', state.stockMax);
            if (state.createdFrom) q.set('createdFrom', state.createdFrom);
            if (state.createdTo) q.set('createdTo', state.createdTo + 'T23:59:59.999');
            if (state.updatedFrom) q.set('updatedFrom', state.updatedFrom);
            if (state.updatedTo) q.set('updatedTo', state.updatedTo + 'T23:59:59.999');
            return q.toString();
        }

        function setPageMeta(page, total, totalPages) {
            state.page = page;
            state.totalPages = totalPages;
            $('pageInfo').textContent = total === 0
                ? 'Hal 0 dari 0 (0 data)'
                : `Hal ${page} dari ${totalPages} (${total} data)`;
            renderPagination();
        }

        function renderRows(items) {
            const tbody = $('productRows');
            if (!items || items.length === 0) {
                tbody.innerHTML = '<tr class="row-empty"><td colspan="13"><span class="material-icons">inbox</span> Tidak ada data yang cocok dengan kriteria.</td></tr>';
                return;
            }
            tbody.innerHTML = items.map((item, idx) => {
                const nomor = ((state.page - 1) * state.pageSize) + idx + 1;
                return `
                <tr>
                    <td class="td-nomor col-no text-center">${nomor}</td>
                    <td class="col-aksi text-center">
                        <div class="field-actions justify-content-center">
                            <a class="btn-icon btn-edit" href="/Products/Edit/${item.id}" title="Edit"><span class="material-icons">edit</span></a>
                            <a class="btn-icon btn-delete" href="/Products/Delete/${item.id}" title="Hapus"><span class="material-icons">delete</span></a>
                        </div>
                    </td>
                    <td class="td-id">${item.id}</td>
                    <td class="td-title fw-semibold">${esc(item.title)}</td>
                    <td class="td-price">${renderHarga(item)}</td>
                    <td>${item.category ? `<span class="badge bg-primary-subtle text-primary-emphasis">${esc(item.category)}</span>` : '-'}</td>
                    <td>${renderRating(item)}</td>
                    <td>${renderStok(item)}</td>
                    <td>${item.createdBy ? esc(item.createdBy) : '-'}</td>
                    <td>${formatDateTime(item.createdAt)}</td>
                    <td>${item.updatedBy ? esc(item.updatedBy) : '-'}</td>
                    <td>${formatDateTime(item.updatedAt)}</td>
                    <td class="td-ver">${item.version}</td>
                </tr>`;
            }).join('');
        }

        function buildPages(current, total) {
            if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
            const candidates = [1, total];
            for (let i = current - 2; i <= current + 2; i++) if (i >= 1 && i <= total) candidates.push(i);
            const sorted = [...new Set(candidates)].sort((a, b) => a - b);
            const out = [];
            let prev = 0;
            for (const p of sorted) {
                if (p - prev > 1) out.push('...');
                out.push(p);
                prev = p;
            }
            return out;
        }

        function pgItem(icon, page, disabled, label) {
            return `<li class="page-item ${disabled ? 'disabled' : ''}"><a class="page-link" href="#" data-page="${page}" title="${label}"><span class="material-icons">${icon}</span></a></li>`;
        }

        function renderPagination() {
            const el = $('pagination');
            const total = state.totalPages;
            if (total <= 1) { el.innerHTML = ''; return; }
            const parts = [];
            parts.push(pgItem('first_page', 1, state.page === 1, 'Halaman pertama'));
            parts.push(pgItem('chevron_left', state.page - 1, state.page === 1, 'Halaman sebelumnya'));
            for (const p of buildPages(state.page, total)) {
                if (p === '...') parts.push('<li class="page-item disabled"><span class="page-link pg-ellipsis">. . .</span></li>');
                else parts.push(`<li class="page-item ${p === state.page ? 'active' : ''}"><a class="page-link" href="#" data-page="${p}">${p}</a></li>`);
            }
            parts.push(pgItem('chevron_right', state.page + 1, state.page === total, 'Halaman berikutnya'));
            parts.push(pgItem('last_page', total, state.page === total, 'Halaman terakhir'));
            el.innerHTML = parts.join('');
        }

        function updateSortIndicators() {
            document.querySelectorAll('.th-sort').forEach((btn) => {
                const active = btn.dataset.sort === state.sortBy;
                btn.classList.toggle('active', active);
                const ic = btn.querySelector('.sort-ic');
                if (!ic) return;
                if (active) ic.textContent = state.sortOrder === 'asc' ? 'arrow_upward' : 'arrow_downward';
                else ic.textContent = 'swap_vert';
            });
        }

        async function loadData() {
            const tbody = $('productRows');
            tbody.innerHTML = '<tr class="row-loading"><td colspan="13"><span class="material-icons spinner-icon">autorenew</span> Memuat data...</td></tr>';
            try {
                const res = await fetch('/api/products/paged?' + buildQuery(), { headers: { [API_KEY_HEADER]: API_KEY } });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const json = await res.json();
                if (!json.isSuccess) throw new Error(json.message || 'Gagal memuat data.');
                renderRows(json.data.items);
                setPageMeta(json.data.page, json.data.total, json.data.totalPages);
            } catch (err) {
                tbody.innerHTML = `<tr class="row-empty"><td colspan="13">Gagal memuat data: ${esc(err.message)}</td></tr>`;
                setPageMeta(1, 0, 0);
            } finally {
                updateSortIndicators();
            }
        }

        function onRangeInput() {
            clearTimeout(rangeTimer);
            rangeTimer = setTimeout(() => {
                state.priceMin = $('priceMin').value;
                state.priceMax = $('priceMax').value;
                state.stockMin = $('stockMin').value;
                state.stockMax = $('stockMax').value;
                state.page = 1;
                loadData();
            }, 400);
        }

        function onDateChange() {
            state.createdFrom = $('createdFrom').value;
            state.createdTo = $('createdTo').value;
            state.updatedFrom = $('updatedFrom').value;
            state.updatedTo = $('updatedTo').value;
            state.page = 1;
            loadData();
        }

        function resetFilter() {
            $('categorySelect').value = '';
            $('priceMin').value = '';
            $('priceMax').value = '';
            $('stockMin').value = '';
            $('stockMax').value = '';
            $('createdFrom').value = '';
            $('createdTo').value = '';
            $('updatedFrom').value = '';
            $('updatedTo').value = '';
            $('searchInput').value = '';
            state.search = '';
            state.category = '';
            state.priceMin = '';
            state.priceMax = '';
            state.stockMin = '';
            state.stockMax = '';
            state.createdFrom = '';
            state.createdTo = '';
            state.updatedFrom = '';
            state.updatedTo = '';
            state.page = 1;
            loadData();
        }

        let searchTimer = null;
        let rangeTimer = null;
        function onSearchInput() {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                state.search = $('searchInput').value;
                state.page = 1;
                loadData();
            }, 350);
        }

        document.addEventListener('DOMContentLoaded', () => {
            $('searchInput').addEventListener('input', onSearchInput);
            $('searchInput').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { clearTimeout(searchTimer); state.search = $('searchInput').value; state.page = 1; loadData(); }
            });
            $('pageSizeSelect').addEventListener('change', (e) => {
                state.pageSize = Number(e.target.value);
                state.page = 1;
                loadData();
            });
            $('categorySelect').addEventListener('change', (e) => {
                state.category = e.target.value;
                state.page = 1;
                loadData();
            });
            ['priceMin', 'priceMax', 'stockMin', 'stockMax'].forEach((id) =>
                $(id).addEventListener('input', onRangeInput));
            ['createdFrom', 'createdTo', 'updatedFrom', 'updatedTo'].forEach((id) =>
                $(id).addEventListener('change', onDateChange));
            $('resetFilter').addEventListener('click', resetFilter);
            document.querySelectorAll('.th-sort').forEach((btn) => btn.addEventListener('click', () => {
                const col = btn.dataset.sort;
                if (state.sortBy === col) {
                    if (state.sortOrder === 'asc') state.sortOrder = 'desc';
                    else { state.sortBy = ''; state.sortOrder = 'asc'; }
                } else {
                    state.sortBy = col;
                    state.sortOrder = 'asc';
                }
                state.page = 1;
                loadData();
            }));
            $('pagination').addEventListener('click', (e) => {
                const link = e.target.closest('.page-link');
                if (!link || link.closest('.disabled')) return;
                e.preventDefault();
                const page = Number(link.dataset.page);
                if (page >= 1 && page <= state.totalPages && page !== state.page) {
                    state.page = page;
                    loadData();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
            loadData();
        });
    </script>
}
