@page
@model cobaproject.Pages.Panel.Settings.PengaturanTokoModel
@{
    ViewData["Title"] = "Pengaturan Toko";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Pengaturan Toko</h5>
        <p class="text-muted small mb-4">
            Pajak berlaku global untuk <strong>semua</strong> pesanan; nilai di-snapshot saat pesanan dibuat,
            jadi mengubahnya tidak mengubah pesanan lama. Ongkir dikelola per ekspedisi di
            <a href="/Panel/Ekspedisi">Master Ekspedisi</a>.
        </p>

        <form method="post" class="w-100" style="max-width: 420px;">
            <div class="mb-3">
                <label class="form-label" for="Pajak">Pajak (persen dari subtotal)</label>
                <input type="number" class="form-control" id="Pajak" name="Pajak"
                       value="@Model.Pajak" min="0" max="100" step="0.01" inputmode="decimal" data-bilangan data-bilangan-desimal data-bilangan-max="100" />
                <span class="field-error">@Html.ValidationMessage("Pajak")</span>
                <div class="form-text">Contoh: 11 berarti 11% dari subtotal, sebelum ongkir.</div>
            </div>
            <input type="hidden" name="PajakVersion" value="@Model.PajakVersion" />
            <button class="btn btn-primary btn-sm" type="submit"><span class="material-icons">save</span> Simpan Pajak</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_BilanganScriptsPartial" />
    <partial name="_ToastScriptsPartial" />
}