@page
@model cobaproject.Pages.Panel.Settings.PengaturanAplikasiModel
@{
    ViewData["Title"] = "Pengaturan Aplikasi";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Pengaturan Aplikasi</h5>
        <p class="text-muted small mb-4">
            Pengaturan ini berlaku global untuk akun pengurus <strong>dan</strong> pelanggan.
        </p>

        <form method="post" class="w-100" style="max-width: 420px;">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label class="form-label" for="AmbangBlokir">Gagal login sebelum akun diblokir</label>
                <input type="number" class="form-control" id="AmbangBlokir" name="AmbangBlokir"
                       value="@Model.AmbangBlokir" min="1" max="99" inputmode="numeric" data-bilangan />
                <span class="field-error">@Html.ValidationMessage("AmbangBlokir")</span>
                <div class="form-text">Default: 5. Blokir bersifat permanen sampai akun di-unblock atau ganti kata sandi.</div>
            </div>
            <input type="hidden" name="AmbangBlokirVersion" value="@Model.AmbangBlokirVersion" />

            <hr class="my-4" />
            <h6 class="fw-semibold mb-1">ALTCHA (Konfirmasi Pesanan)</h6>
            <p class="text-muted small mb-3">Verifikasi keamanan self-hosted, tanpa layanan pihak ketiga. Kosongkan untuk menonaktifkan. Isi kunci rahasia (minimal 16 karakter, makin panjang makin kuat) untuk mengaktifkannya; bisa dari <code>openssl rand -hex 32</code> atau generator acak mana pun.</p>
            <div class="mb-3">
                <label class="form-label" for="AltchaHmacKey">Kunci Rahasia ALTCHA (HMAC)</label>
                <input type="password" class="form-control font-monospace" id="AltchaHmacKey" name="AltchaHmacKey" value="@Model.AltchaHmacKey" autocomplete="off" spellcheck="false" />
            </div>
            <input type="hidden" name="AltchaHmacKeyVersion" value="@Model.AltchaHmacKeyVersion" />

            <button class="btn btn-primary btn-sm" type="submit"><span class="material-icons">save</span> Simpan</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_BilanganScriptsPartial" />
    <partial name="_ToastScriptsPartial" />
}