@page
@model cobaproject.Pages.Panel.Settings.PengaturanAplikasiModel
@{
    ViewData["Title"] = "Pengaturan Aplikasi";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Pengaturan Aplikasi</h5>
        <p class="text-muted small mb-4">
            Pengaturan ini berlaku global untuk akun pengurus <strong>dan</strong> pelanggan.
        </p>

        <form method="post" class="w-100" style="max-width: 420px;">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label class="form-label" for="AmbangBlokir">Gagal login sebelum akun diblokir</label>
                <input type="number" class="form-control" id="AmbangBlokir" name="AmbangBlokir"
                       value="@Model.AmbangBlokir" min="1" max="99" inputmode="numeric" data-bilangan />
                <span class="field-error">@Html.ValidationMessage("AmbangBlokir")</span>
                <div class="form-text">Default: 5. Blokir bersifat permanen sampai akun di-unblock atau ganti kata sandi.</div>
            </div>
            <input type="hidden" name="AmbangBlokirVersion" value="@Model.AmbangBlokirVersion" />

            <hr class="my-4" />
            <h6 class="fw-semibold mb-1">reCAPTCHA (Konfirmasi Pesanan)</h6>
            <p class="text-muted small mb-3">Kosongkan keduanya untuk menonaktifkan verifikasi reCAPTCHA pada checkout. Isi keduanya dari konsol Google reCAPTCHA (v2 Checkbox) untuk mengaktifkannya.</p>
            <div class="mb-3">
                <label class="form-label" for="RecaptchaSiteKey">Site Key</label>
                <input type="text" class="form-control" id="RecaptchaSiteKey" name="RecaptchaSiteKey" value="@Model.RecaptchaSiteKey" autocomplete="off" spellcheck="false" />
            </div>
            <input type="hidden" name="RecaptchaSiteKeyVersion" value="@Model.RecaptchaSiteKeyVersion" />
            <div class="mb-3">
                <label class="form-label" for="RecaptchaSecretKey">Secret Key</label>
                <input type="password" class="form-control" id="RecaptchaSecretKey" name="RecaptchaSecretKey" value="@Model.RecaptchaSecretKey" autocomplete="off" />
            </div>
            <input type="hidden" name="RecaptchaSecretKeyVersion" value="@Model.RecaptchaSecretKeyVersion" />

            <button class="btn btn-primary btn-sm" type="submit"><span class="material-icons">save</span> Simpan</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_BilanganScriptsPartial" />
    <partial name="_ToastScriptsPartial" />
}