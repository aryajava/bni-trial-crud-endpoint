@page
@model cobaproject.Pages.Ekspedisi.IndexModel
@{
    ViewData["Title"] = "Master Ekspedisi";
}

<div class="page-header">
    <h1><span class="material-icons">local_shipping</span> Master Ekspedisi</h1>
    <p class="text-muted small mb-0">Ongkir per ekspedisi; pembeli akan memilih ekspedisi saat checkout.</p>
</div>

<div class="card card-soft mb-4">
    <div class="card-body p-3">
        <form method="post" asp-page-handler="Create">
            <div class="d-flex gap-2 align-items-end flex-wrap">
                <div class="flex-grow-1" style="max-width: 280px;">
                    <label class="form-label mb-0" asp-for="Create.Name">Nama Ekspedisi</label>
                    <input asp-for="Create.Name" class="form-control form-control-sm" placeholder="Contoh: JNE" />
                    @Html.ValidationMessageFor(m => m.Create.Name, null, new { @class = "field-error" })
                </div>
                <div style="width: 160px;">
                    <label class="form-label mb-0" asp-for="Create.ShippingFee">Ongkir (Rp)</label>
                    <input type="number" asp-for="Create.ShippingFee" class="form-control form-control-sm" min="0" step="0.01" inputmode="decimal" data-rupiah data-rupiah-target="Create.ShippingFee" />
                    @Html.ValidationMessageFor(m => m.Create.ShippingFee, null, new { @class = "field-error" })
                </div>
                <button class="btn btn-primary btn-sm" type="submit"><span class="material-icons">add</span> Tambah</button>
            </div>
        </form>
    </div>
</div>

<div class="card card-soft">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-end">
            <div class="d-flex flex-column gap-1 flex-grow-1" style="max-width: 320px;">
                <label class="cluster-label text-secondary fw-semibold mb-0" for="searchInput">Cari</label>
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Nama ekspedisi..." autocomplete="off" />
            </div>
        </div>
        <div class="table-wrap">
            <table class="table table-data align-middle mb-0">
                <thead>
                    <tr>
                        <th class="col-no text-center">No</th>
                        <th><button type="button" class="th-sort" data-sort="name">Nama <span class="material-icons sort-ic">swap_vert</span></button></th>
                        <th><button type="button" class="th-sort" data-sort="shippingFee">Ongkir <span class="material-icons sort-ic">swap_vert</span></button></th>
                        <th>Status</th>
                        <th class="col-aksi">Aksi</th>
                    </tr>
                </thead>
                <tbody id="courierRows"></tbody>
            </table>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
            <div id="pageInfo" class="text-muted small"></div>
            <ul id="pagination" class="pagination pagination-sm mb-0"></ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_KEY_HEADER = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApiKeyHeader));
        const API_KEY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApiKey));

        const state = { page: 1, pageSize: 20, sortBy: '', sortOrder: 'asc', search: '', totalPages: 0 };
        const $ = (id) => document.getElementById(id);

        function esc(s) {
            return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        function formatRp(n) { return 'Rp ' + Math.round(n || 0).toLocaleString('id-ID'); }

        function buildQuery() {
            const q = new URLSearchParams();
            q.set('page', state.page);
            q.set('pageSize', state.pageSize);
            if (state.sortBy) { q.set('sortBy', state.sortBy); q.set('sortOrder', state.sortOrder); }
            if (state.search.trim()) q.set('search', state.search.trim());
            return q.toString();
        }

        function renderRows(items) {
            const tbody = $('courierRows');
            if (!items || items.length === 0) {
                tbody.innerHTML = '<tr class="row-empty"><td colspan="5"><span class="material-icons">inbox</span> Tidak ada data.</td></tr>';
                return;
            }
            tbody.innerHTML = items.map((c, idx) => {
                const nomor = ((state.page - 1) * state.pageSize) + idx + 1;
                const status = c.isActive
                    ? '<span class="badge bg-success-subtle text-success-emphasis">Aktif</span>'
                    : '<span class="badge bg-secondary-subtle text-secondary-emphasis">Nonaktif</span>';
                let aksi = '<a class="btn-icon btn-edit btn-edit-courier" href="#" data-id="' + c.id + '" data-name="' + esc(c.name) + '" data-fee="' + c.shippingFee + '" data-version="' + c.version + '" title="Ubah nama/ongkir"><span class="material-icons">edit</span></a>';
                if (c.isActive) {
                    aksi += ' <button class="btn-icon btn-delete btn-disable-courier" href="#" data-id="' + c.id + '" data-name="' + esc(c.name) + '" title="Nonaktifkan"><span class="material-icons">block</span></button>';
                } else {
                    aksi += ' <button class="btn-icon btn-edit btn-enable-courier" href="#" data-id="' + c.id + '" title="Aktifkan"><span class="material-icons">check_circle</span></button>';
                }
                return '<tr class="' + (c.isActive ? '' : 'table-secondary') + '">' +
                    '<td class="td-nomor text-center">' + nomor + '</td>' +
                    '<td class="fw-semibold">' + esc(c.name) + '</td>' +
                    '<td class="td-nomor">' + formatRp(c.shippingFee) + '</td>' +
                    '<td>' + status + '</td>' +
                    '<td><div class="field-actions">' + aksi + '</div></td>' +
                    '</tr>';
            }).join('');
        }

        function buildPages(current, total) {
            if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
            const c = [1, total];
            for (let i = current - 2; i <= current + 2; i++) if (i >= 1 && i <= total) c.push(i);
            return [...new Set(c)].sort((a, b) => a - b);
        }

        function renderPagination() {
            const total = Math.max(1, state.totalPages);
            const parts = [];
            parts.push('<li class="page-item ' + (state.page <= 1 ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="' + (state.page - 1) + '"><span class="material-icons">chevron_left</span></a></li>');
            for (const p of buildPages(state.page, state.totalPages)) {
                parts.push('<li class="page-item ' + (p === state.page ? 'active' : '') + '"><a class="page-link" href="#" data-page="' + p + '">' + p + '</a></li>');
            }
            parts.push('<li class="page-item ' + (state.page >= total ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="' + (state.page + 1) + '"><span class="material-icons">chevron_right</span></a></li>');
            $('pagination').innerHTML = parts.join('');
        }

        function updateSortIndicators() {
            document.querySelectorAll('.th-sort').forEach((btn) => {
                const active = btn.dataset.sort === state.sortBy;
                btn.classList.toggle('active', active);
                const ic = btn.querySelector('.sort-ic');
                if (ic) ic.textContent = active ? (state.sortOrder === 'asc' ? 'arrow_upward' : 'arrow_downward') : 'swap_vert';
            });
        }

        async function loadData() {
            const tbody = $('courierRows');
            tbody.innerHTML = '<tr class="row-loading"><td colspan="5"><span class="material-icons spinner-icon">autorenew</span> Memuat data...</td></tr>';
            try {
                const res = await fetch('/api/couriers/paged?' + buildQuery(), { headers: { [API_KEY_HEADER]: API_KEY } });
                const json = await res.json().catch(() => null);
                if (!res.ok || !json.isSuccess) throw new Error((json && json.message) || ('HTTP ' + res.status));
                renderRows(json.data.items);
                state.totalPages = json.data.totalPages || 0;
                $('pageInfo').textContent = json.data.total === 0
                    ? 'Hal 0 dari 0 (0 data)'
                    : 'Hal ' + json.data.page + ' dari ' + json.data.totalPages + ' (' + json.data.total + ' data)';
                renderPagination();
            } catch (err) {
                tbody.innerHTML = '<tr class="row-empty"><td colspan="5">Gagal memuat data: ' + esc(err.message) + '</td></tr>';
            } finally {
                updateSortIndicators();
            }
        }

        async function aksi(method, url, body, pesanSukses) {
            try {
                const res = await fetch(url, {
                    method: method,
                    headers: { [API_KEY_HEADER]: API_KEY, 'Content-Type': 'application/json' },
                    body: body ? JSON.stringify(body) : undefined
                });
                const json = await res.json().catch(() => null);
                if (!res.ok || !json.isSuccess) throw new Error((json && json.errors && json.errors[0]) || (json && json.message) || ('HTTP ' + res.status));
                Swal.fire({ toast: true, position: "bottom-end", icon: "success", title: pesanSukses || json.message, showConfirmButton: false, timer: 2500 });
                loadData();
            } catch (err) {
                Swal.fire({ toast: true, position: "bottom-end", icon: "error", title: err.message, showConfirmButton: false, timer: 4000 });
            }
        }

        let searchTimer = null;
        document.addEventListener('DOMContentLoaded', () => {
            $('searchInput').addEventListener('input', () => {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(() => { state.search = $('searchInput').value; state.page = 1; loadData(); }, 350);
            });
            document.querySelectorAll('.th-sort').forEach((btn) => btn.addEventListener('click', () => {
                const col = btn.dataset.sort;
                if (state.sortBy === col) {
                    if (state.sortOrder === 'asc') state.sortOrder = 'desc';
                    else { state.sortBy = ''; state.sortOrder = 'asc'; }
                } else { state.sortBy = col; state.sortOrder = 'asc'; }
                state.page = 1;
                loadData();
            }));
            $('pagination').addEventListener('click', (e) => {
                const link = e.target.closest('.page-link');
                if (!link || link.closest('.disabled')) return;
                e.preventDefault();
                const page = Number(link.dataset.page);
                if (page >= 1 && page <= state.totalPages && page !== state.page) {
                    state.page = page;
                    loadData();
                }
            });
            $('courierRows').addEventListener('click', (e) => {
                const t = e.target.closest('button, a');
                if (!t) return;
                e.preventDefault();
                if (t.classList.contains('btn-edit-courier')) {
                    Swal.fire({
                        title: 'Ubah Ekspedisi',
                        html:
                            '<input id="edNama" class="swal2-input" value="' + esc(t.dataset.name) + '" placeholder="Nama ekspedisi">' +
                            '<input id="edOngkir" class="swal2-input" type="number" min="0" step="0.01" value="' + t.dataset.fee + '" placeholder="Ongkir (Rp)">',
                        showCancelButton: true,
                        confirmButtonText: 'Simpan',
                        cancelButtonText: 'Batal',
                        preConfirm: () => {
                            const nama = document.getElementById('edNama').value.trim();
                            const ongkir = Number(document.getElementById('edOngkir').value);
                            if (!nama) { Swal.showValidationMessage('Nama wajib diisi.'); return false; }
                            if (isNaN(ongkir) || ongkir < 0) { Swal.showValidationMessage('Ongkir harus angka 0 atau lebih.'); return false; }
                            return { nama, ongkir };
                        }
                    }).then((r) => {
                        if (r.isConfirmed) {
                            aksi('PUT', '/api/couriers/' + t.dataset.id, { name: r.value.nama, shippingFee: r.value.ongkir, version: Number(t.dataset.version) });
                        }
                    });
                } else if (t.classList.contains('btn-disable-courier')) {
                    Swal.fire({ title: 'Nonaktifkan ' + t.dataset.name + '?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Ya, nonaktifkan', cancelButtonText: 'Batal' })
                        .then((r) => { if (r.isConfirmed) aksi('DELETE', '/api/couriers/' + t.dataset.id); });
                } else if (t.classList.contains('btn-enable-courier')) {
                    aksi('POST', '/api/couriers/' + t.dataset.id + '/activate');
                }
            });
            loadData();
        });
    </script>
}