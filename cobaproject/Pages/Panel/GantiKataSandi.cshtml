@page
@model cobaproject.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Ganti Password";
    Layout = "_LoginLayout";
}

<div class="card card-soft p-4" style="max-width: 420px; margin: 0 auto;">
    <h1 class="h4 mb-3 text-center">Ganti Password</h1>
    <p class="text-muted small text-center mb-3">
        Akun Anda diblokir setelah beberapa kali gagal masuk.
        Masukkan username dan password baru untuk membuka blokir.
    </p>

    <form method="post">
        <div asp-validation-summary="All" class="pesan-error mb-3"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="Username">Username</label>
            <input asp-for="Username" class="form-control" autocomplete="username" />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="NewPassword">Password Baru</label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="ConfirmPassword">Konfirmasi Password</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Simpan &amp; Buka Blokir</button>
        <a class="btn btn-link w-100 mt-2" asp-page="/Panel/Masuk">Kembali ke Login</a>
    </form>
</div>