@page
@model cobaproject.Pages.Users.CreateModel
@{
    ViewData["Title"] = "Tambah User";
    ViewData["CrumbRoot"] = "Master User";
}

<div class="page-header">
    <h1>Tambah User</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-page="Index"><span class="material-icons">arrow_back</span> Kembali</a>
</div>

<div class="card card-soft">
    <div class="card-body p-3">
        <form method="post" style="max-width: 560px;">
            <div class="mb-3">
                <label class="form-label" asp-for="Form.Username">Username</label>
                <input asp-for="Form.Username" class="form-control" autocomplete="off" />
                @Html.ValidationMessageFor(m => m.Form.Username, null, new { @class = "field-error" })
                <div class="form-text">Huruf kecil dan angka, 3–50 karakter.</div>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Form.DisplayName">Nama Tampilan</label>
                <input asp-for="Form.DisplayName" class="form-control" />
                @Html.ValidationMessageFor(m => m.Form.DisplayName, null, new { @class = "field-error" })
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Form.Password">Password Awal</label>
                <input asp-for="Form.Password" class="form-control" autocomplete="new-password" />
                @Html.ValidationMessageFor(m => m.Form.Password, null, new { @class = "field-error" })
                <div class="form-text">Minimal 6 karakter.</div>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Form.Role">Role</label>
                <select asp-for="Form.Role" class="form-select">
                    @foreach (var role in Model.AllowedRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                @Html.ValidationMessageFor(m => m.Form.Role, null, new { @class = "field-error" })
            </div>

            <div class="mt-4 d-flex gap-2 flex-wrap">
                <button class="btn btn-primary btn-sm" type="submit"><span class="material-icons">save</span> Simpan</button>
                <a class="btn btn-outline-secondary btn-sm" asp-page="Index"><span class="material-icons">close</span> Batal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}